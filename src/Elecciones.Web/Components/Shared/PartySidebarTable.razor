@using Elecciones.Application.Models

<aside class="ws-party-sidebar">
    <div class="ws-party-header">
        <span>Partidos (@Parties.Count)</span>
        <button class="btn btn-sm btn-link p-0 text-decoration-none"
                type="button"
                title="Refrescar partidos"
                @onclick="OnRefreshClicked"
                disabled="@Loading">
            @(Loading ? "..." : "↻")
        </button>
    </div>

    <div class="table-responsive" style="max-height: calc(100vh - 115px); overflow-y: auto;">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Siglas</th>
                    <th class="text-end pe-3">Esc</th>
                </tr>
            </thead>
            <tbody>
                @if (Parties.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted small py-3">Sin datos</td>
                    </tr>
                }
                else
                {
                    @foreach (var party in Parties)
                    {
                        var isSelected = string.Equals(SelectedPartyCode, party.Codigo, StringComparison.OrdinalIgnoreCase);
                        var escanos = Oficiales ? party.Escanios : party.EscaniosHastaSondeo;
                        <tr class="ws-party-row @(isSelected ? "table-primary fw-semibold" : null)"
                            @onclick="() => OnPartySelected.InvokeAsync(party)"
                            @ondblclick="() => OnPartyDoubleClicked.InvokeAsync(party)">
                            <td class="ps-3">
                                <span>@party.Siglas</span>
                                @if (ShowUltimoIndicators && party.EsUltimoEscano != 0)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Último escaño">ÚLT</span>
                                }
                                else if (ShowUltimoIndicators && party.LuchaUltimoEscano != 0)
                                {
                                    <span class="badge bg-info text-dark ms-1" title="En lucha">R</span>
                                }
                            </td>
                            <td class="text-end pe-3 font-monospace">
                                @if (!Oficiales && party.EscaniosDesdeSondeo != party.EscaniosHastaSondeo && party.EscaniosDesdeSondeo > 0)
                                {
                                    <span class="text-muted small">@party.EscaniosDesdeSondeo-</span>@party.EscaniosHastaSondeo
                                }
                                else
                                {
                                    @escanos
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</aside>

@code {
    [Parameter] public IReadOnlyList<PartidoSnapshot> Parties { get; set; } = [];
    [Parameter] public string SelectedPartyCode { get; set; } = string.Empty;
    [Parameter] public bool Oficiales { get; set; }
    [Parameter] public bool ShowUltimoIndicators { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback<PartidoSnapshot> OnPartySelected { get; set; }
    [Parameter] public EventCallback<PartidoSnapshot> OnPartyDoubleClicked { get; set; }
    [Parameter] public EventCallback OnRefreshClicked { get; set; }
}

