@using System.Globalization
@using Elecciones.Application.Models

<div class="ws-action-bar" role="toolbar" aria-label="Control de emisión de escena">
    <div class="ws-action-primary-group">
        <button class="ws-btn ws-btn-live ws-action-btn ws-action-btn-fixed"
                type="button"
                @onclick="() => OnAction.InvokeAsync(OperationActionType.Enter)"
                disabled="@Disabled">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="6 4 20 12 6 20 6 4" />
            </svg>
            ENTRA
        </button>

        <button class="ws-btn ws-btn-primary ws-action-btn ws-action-btn-update-fixed"
                type="button"
                @onclick="() => OnAction.InvokeAsync(OperationActionType.Update)"
                disabled="@Disabled">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                <path d="M3 3v5h5" />
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                <path d="M16 16h5v5" />
            </svg>
            @UpdateLabel
        </button>

        <button class="ws-btn ws-btn-amber ws-action-btn ws-action-btn-fixed"
                type="button"
                @onclick="() => OnAction.InvokeAsync(OperationActionType.Exit)"
                disabled="@Disabled">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="6" y="6" width="12" height="12" rx="1.5" />
            </svg>
            SALE
        </button>
    </div>

    <span class="ws-scene-tag">
        Escena
        <strong>@SceneLabel</strong>
    </span>

    @if (Oficiales && EscrutadoGeneral.HasValue)
    {
        <span class="ws-chip ws-chip-accent ws-mono" title="Porcentaje de escrutinio general de la elección activa">
            Escrutinio Gral.: <strong>@FormatPct(EscrutadoGeneral.Value)%</strong>
        </span>
        @if (IsSubCircunscripcion && EscrutadoCircunscripcion.HasValue)
        {
            <span class="ws-chip ws-mono" title="Porcentaje escrutado en la circunscripción seleccionada">
                Circ.: <strong>@FormatPct(EscrutadoCircunscripcion.Value)%</strong>
            </span>
        }
    }

    <button class="ws-btn ws-btn-danger-outline ms-auto"
            type="button"
            @onclick="() => OnAction.InvokeAsync(OperationActionType.Reset)"
            disabled="@Disabled"
            title="Reiniciar estado de escena en motor gráfico">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18" />
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
        </svg>
        RESET
    </button>
</div>

@code {
    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-ES");

    [Parameter] public string SceneLabel { get; set; } = string.Empty;
    [Parameter] public string UpdateLabel { get; set; } = "ACTUALIZA";
    [Parameter] public bool Oficiales { get; set; }
    [Parameter] public double? EscrutadoGeneral { get; set; }
    [Parameter] public double? EscrutadoCircunscripcion { get; set; }
    [Parameter] public bool IsSubCircunscripcion { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<OperationActionType> OnAction { get; set; }

    private static string FormatPct(double value) => value.ToString("0.00", EsCulture);
}
