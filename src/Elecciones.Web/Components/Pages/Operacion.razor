    private async Task RefreshSupportDataAsync(GraphicModule module)
    {
        supportDataLoading = true;
        supportDataError = string.Empty;
        try
        {
            var snapshot = await DataService.GetSnapshotAsync(BuildQuery(), oficiales);
            supportDataRows = snapshot.Partidos;
            supportDataModule = module;
            supportDataUpdatedUtc = DateTime.UtcNow;
            var first = GetFilteredSupportRows(module).FirstOrDefault();
            if (first is not null)
            {
                selectedSupportPartyCodes[module] = first.Codigo;
            }
        }
        catch (Exception ex)
        {
            supportDataError = $"Error al cargar datos de apoyo: {ex.Message}";
        }
        finally
        {
            supportDataLoading = false;
        }
    }

    private IReadOnlyList<PartidoSnapshot> GetFilteredSupportRows(GraphicModule module)
    {
        if (supportDataModule != module)
        {
            return [];
        }

        var activeGraphic = GetActiveGraphic(module).ToUpperInvariant();
        var rows = supportDataRows.Where(x => !string.IsNullOrWhiteSpace(x.Codigo));

        return activeGraphic switch
        {
            "SEDES" => rows
                .Where(x => GetDisplayEscanos(x) > 0)
                .OrderByDescending(GetDisplayEscanos)
                .ThenByDescending(x => x.Votos)
                .ToList(),
            "ULTIMO ESCANO" => rows
                .OrderByDescending(x => x.EsUltimoEscano)
                .ThenByDescending(x => x.LuchaUltimoEscano)
                .ThenByDescending(GetDisplayEscanos)
                .ThenByDescending(x => x.Votos)
                .ToList(),
            "PARTICIPACION" => rows
                .OrderBy(x => x.Codigo, StringComparer.Ordinal)
                .ToList(),
            _ => rows
                .OrderByDescending(GetDisplayEscanos)
                .ThenByDescending(x => x.Votos)
                .ToList()
        };
    }

