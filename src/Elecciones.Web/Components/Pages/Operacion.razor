    private void StartAutoRefreshLoop()
    {
        autoRefreshCts = new CancellationTokenSource();
        autoRefreshLoopTask = Task.Run(() => AutoRefreshLoopAsync(autoRefreshCts.Token));
    }

    private async Task AutoRefreshLoopAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            var delaySeconds = Math.Clamp(autoRefreshIntervalSeconds, 2, 60);
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);
                await InvokeAsync(() => AutoRefreshTickAsync(cancellationToken));
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Keep loop alive to avoid losing auto-refresh in long running sessions.
            }
        }
    }

    private async Task RunAutoRefreshCheckNowAsync()
    {
        await AutoRefreshTickAsync(CancellationToken.None);
    }

    private async Task AutoRefreshTickAsync(CancellationToken cancellationToken)
    {
        if (autoRefreshRunning)
        {
            return;
        }

        autoRefreshRunning = true;
        autoRefreshStatusIsError = false;

        try
        {
            if (!autoRefreshEnabled)
            {
                autoRefreshStatusMessage = "Autoactualizacion desactivada.";
                return;
            }

            moduleStates = ModuleLockService.GetStates();
            var modulesOnAir = moduleStates
                .Where(state => state.IsOnAir)
                .Where(IsMine)
                .Where(state => CanOperateModule(state.Module))
                .Select(state => state.Module)
                .Distinct()
                .ToList();

            if (modulesOnAir.Count == 0)
            {
                lastAutoRefreshCheckUtc = DateTime.UtcNow;
                autoRefreshStatusMessage = "Sin modulos propios en aire.";
                return;
            }

            var snapshot = await DataService.GetSnapshotAsync(BuildQuery(), oficiales, cancellationToken);
            var fingerprint = BuildSnapshotFingerprint(snapshot);
            lastAutoRefreshCheckUtc = DateTime.UtcNow;

            if (string.Equals(fingerprint, lastAutoRefreshFingerprint, StringComparison.Ordinal))
            {
                autoRefreshStatusMessage = "Sin cambios de datos.";
                return;
            }

            lastAutoRefreshFingerprint = fingerprint;
            var updatedModules = new List<GraphicModule>();

            foreach (var module in modulesOnAir)
            {
                if (!selectedScenes.TryGetValue(module, out var scene) || string.IsNullOrWhiteSpace(scene))
                {
                    continue;
                }

                var request = new OperationRequest
                {
                    OperatorId = NormalizedOperatorId,
                    Module = module,
                    Scene = scene,
                    Action = OperationActionType.Update,
                    SceneSeconds = sceneSeconds > 0 ? sceneSeconds : null,
                    Command = GraphicCommand.None,
                    Target = selectedTarget,
                    Oficiales = oficiales,
                    ExportName = string.IsNullOrWhiteSpace(exportName) ? "BrainStorm" : exportName.Trim(),
                    Query = BuildQuery()
                };

                var result = await OperationService.ExecuteAsync(request, cancellationToken);
                if (!result.Success)
                {
                    autoRefreshStatusIsError = true;
                    autoRefreshStatusMessage = $"Error autoactualizando {module}: {result.Message}";
                    return;
                }

                updatedModules.Add(module);
                lastResult = result;
            }

            if (updatedModules.Count > 0)
            {
                lastAutoRefreshAppliedUtc = DateTime.UtcNow;
                autoRefreshStatusMessage = $"Autoactualizados: {string.Join(", ", updatedModules)}";
                feedbackMessage = autoRefreshStatusMessage;
                feedbackIsError = false;
            }
            else
            {
                autoRefreshStatusMessage = "No habia escenas configuradas para autoactualizar.";
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            autoRefreshStatusIsError = true;
            autoRefreshStatusMessage = $"Error en autoactualizacion: {ex.Message}";
        }
        finally
        {
            autoRefreshRunning = false;
            StateHasChanged();
        }
    }

    private static string BuildSnapshotFingerprint(BrainStormSnapshot snapshot)
    {
        var rows = snapshot.Partidos
            .Where(p => !string.IsNullOrWhiteSpace(p.Codigo))
            .OrderBy(p => p.Codigo, StringComparer.OrdinalIgnoreCase)
            .Select(p => $"{p.Codigo}:{p.Escanios}:{p.EscaniosHastaSondeo}:{p.Votos}:{p.PorcentajeVoto:0.####}")
            .ToList();

        return string.Join(
            "|",
            snapshot.Circunscripcion.Codigo,
            snapshot.Avance,
            snapshot.Escrutado.ToString("0.####"),
            snapshot.Participacion.ToString("0.####"),
            string.Join(";", rows));
    }

    private SnapshotQuery BuildQuery()
    {
        return new SnapshotQuery
        {
            ElectionSlot = selectedElectionSlot,
            ConnectionType = selectedConnectionType,
            Kind = queryKind,
            CircunscripcionCodigo = selectedCircunscripcionCodigo,
            AutonomiaCodigo = autonomiaCodigo.Trim(),
            PartidoCodigo = partidoCodigo.Trim(),
            Avance = selectedAvance == 0 ? null : selectedAvance,
            IncludeZeroSeats = includeZeroSeats,
            MedioCodigo = selectedMedioCodigo.Trim()
        };
    }

    private void Acquire(GraphicModule module)
    {
        if (!CanOperateModule(module))
        {
            feedbackMessage = $"No tienes permisos para bloquear el modulo {module}.";
            feedbackIsError = true;
            return;
        }

        var owner = NormalizedOperatorId;
        var ok = ModuleLockService.TryAcquire(module, owner);
        feedbackMessage = ok
            ? $"Modulo {module} bloqueado por {owner}."
            : $"No se puede bloquear {module}. Ya tiene owner.";
        feedbackIsError = !ok;
    }

    private void Release(GraphicModule module)
    {
        var owner = NormalizedOperatorId;
        var ok = ModuleLockService.Release(module, owner);
        feedbackMessage = ok
            ? $"Modulo {module} desbloqueado."
            : $"No se puede desbloquear {module}. Solo el owner puede hacerlo.";
        feedbackIsError = !ok;
    }

