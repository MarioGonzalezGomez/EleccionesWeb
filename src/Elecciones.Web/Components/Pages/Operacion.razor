    private async Task RunSupportCommandAsync(GraphicModule module, GraphicCommand command)
    {
        if (!CanOperateModule(module))
        {
            feedbackMessage = $"No tienes permisos para operar el modulo {module}.";
            feedbackIsError = true;
            return;
        }

        if (!ModuleLockService.IsOwner(module, NormalizedOperatorId))
        {
            feedbackMessage = $"No puedes operar {module}. Bloquealo primero con tu usuario.";
            feedbackIsError = true;
            return;
        }

        var selected = GetSelectedSupportParty(module);
        var commandValue = selected?.Codigo ?? string.Empty;

        if (command is GraphicCommand.SedesEntra
            or GraphicCommand.SedesEncadena
            or GraphicCommand.UltimoEntraPartidoIzquierda
            or GraphicCommand.UltimoEntraPartidoDerecha)
        {
            if (string.IsNullOrWhiteSpace(commandValue))
            {
                feedbackMessage = "Selecciona un partido en la tabla de apoyo para ejecutar esta accion.";
                feedbackIsError = true;
                return;
            }
        }

        var request = new OperationRequest
        {
            OperatorId = NormalizedOperatorId,
            Module = module,
            Scene = selectedScenes.TryGetValue(module, out var scene) ? scene : string.Empty,
            Action = OperationActionType.Update,
            SceneSeconds = sceneSeconds > 0 ? sceneSeconds : null,
            Command = command,
            CommandValue = commandValue,
            Target = selectedTarget,
            Oficiales = oficiales,
            ExportName = string.IsNullOrWhiteSpace(exportName) ? "BrainStorm" : exportName.Trim(),
            Query = BuildQuery()
        };

        await ExecuteAsync(request);
    }

