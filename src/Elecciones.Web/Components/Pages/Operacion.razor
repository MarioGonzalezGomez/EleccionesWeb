@page "/operacion"
@page "/operacion/{moduleHint}"
@attribute [Authorize]
@implements IDisposable
@using Elecciones.Application.Abstractions
@using Elecciones.Application.Models
@using Elecciones.Infrastructure.Options
@inject IModuleLockService ModuleLockService
@inject IOperationService OperationService
@inject IEleccionesDataService DataService
@inject IOperatorAuthorizationService AuthorizationService
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Operacion</PageTitle>

<h1>@GetPageTitle()</h1>

@if (!string.IsNullOrWhiteSpace(feedbackMessage))
{
    <div class="alert @(feedbackIsError ? "alert-danger" : "alert-success")" role="alert">
        @feedbackMessage
    </div>
}

<div class="alert alert-info" role="alert">
    Rol: <strong>@CurrentRole</strong> | Modulos permitidos: <strong>@AllowedModulesText</strong>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-2">
        <label class="form-label">Eleccion activa</label>
        <select class="form-select" value="@selectedElectionSlot" @onchange="OnElectionSlotChanged">
            @foreach (var slot in availableElectionSlots)
            {
                <option value="@slot">Eleccion @slot</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-2">
        <label class="form-label">Origen BD</label>
        <select class="form-select" value="@selectedConnectionType" @onchange="OnConnectionTypeChanged">
            <option value="0">Auto</option>
            <option value="1">Principal</option>
            <option value="2">Reserva</option>
            <option value="3">Local</option>
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label">Operador</label>
        <input class="form-control" value="@operatorId" disabled />
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label">Tipo consulta</label>
        <select class="form-select" @bind="queryKind">
            @foreach (var kind in Enum.GetValues<SnapshotQueryKind>())
            {
                <option value="@kind">@kind</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label">Destino TCP</label>
        <select class="form-select" @bind="selectedTarget">
            @foreach (var target in Enum.GetValues<GraphicsTarget>())
            {
                <option value="@target">@target</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <div class="form-check mt-4">
            <input id="oficiales" class="form-check-input" type="checkbox" @bind="oficiales" />
            <label class="form-check-label" for="oficiales">Datos oficiales</label>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label">Circunscripcion</label>
        <select class="form-select" @bind="selectedCircunscripcionCodigo" disabled="@(queryKind != SnapshotQueryKind.Circunscripcion)">
            @foreach (var circ in circunscripciones)
            {
                <option value="@circ.Codigo">@circ.Codigo - @circ.Nombre</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label">Codigo autonomia</label>
        <input class="form-control" @bind="autonomiaCodigo" placeholder="Ej: 02" disabled="@(!RequiresAutonomia)" />
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label">Codigo partido</label>
        <input class="form-control" @bind="partidoCodigo" placeholder="Ej: 00001" disabled="@(!RequiresPartido)" />
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <label class="form-label">Nombre CSV</label>
        <input class="form-control" @bind="exportName" />
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label">Medio sondeo</label>
        <select class="form-select" @bind="selectedMedioCodigo" disabled="@oficiales">
            @foreach (var medio in medios)
            {
                <option value="@medio.Codigo">@medio.Descripcion</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <div class="form-check mt-4">
            <input id="includeZero" class="form-check-input" type="checkbox" @bind="includeZeroSeats" />
            <label class="form-check-label" for="includeZero">Incluir partidos con 0 escanos</label>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-3">
        <label class="form-label">Avance</label>
        <select class="form-select" @bind="selectedAvance">
            <option value="0">Automatico</option>
            <option value="1">Avance 1</option>
            <option value="2">Avance 2</option>
            <option value="3">Avance 3</option>
            <option value="4">Final</option>
        </select>
        <div class="small text-muted mt-1">
            @GetAvanceLabel(selectedAvance)
        </div>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label">Cuenta atras (seg)</label>
        <input class="form-control" type="number" min="0" @bind="sceneSeconds" />
    </div>
</div>

<div class="border rounded p-3 mb-4">
    <h5 class="mb-3">Actualizacion en vivo</h5>
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
            <div class="form-check">
                <input id="autoRefreshEnabled" class="form-check-input" type="checkbox" @bind="autoRefreshEnabled" />
                <label class="form-check-label" for="autoRefreshEnabled">Modo autoactualizacion</label>
            </div>
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label form-label-sm">Intervalo (seg)</label>
            <input class="form-control form-control-sm" type="number" min="2" max="60" @bind="autoRefreshIntervalSeconds" />
        </div>
        <div class="col-12 col-md-3">
            <button class="btn btn-sm btn-outline-primary" @onclick="RunAutoRefreshCheckNowAsync" disabled="@autoRefreshRunning">
                @(autoRefreshRunning ? "Comprobando..." : "Comprobar ahora")
            </button>
        </div>
    </div>
    <div class="small text-muted mt-2">
        Ultima comprobacion: @FormatUtc(lastAutoRefreshCheckUtc) | Ultima actualizacion automatica: @FormatUtc(lastAutoRefreshAppliedUtc)
    </div>
    @if (!string.IsNullOrWhiteSpace(autoRefreshStatusMessage))
    {
        <div class="small mt-1 @(autoRefreshStatusIsError ? "text-danger" : "text-success")">
            @autoRefreshStatusMessage
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-12 col-xl-5">
        <h4>Bloqueo de modulos</h4>
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Modulo</th>
                    <th>Estado</th>
                    <th>En aire</th>
                    <th>Owner</th>
                    <th>Ultima accion (UTC)</th>
                    <th>Escena</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var state in GetVisibleModuleStates())
                {
                    var mine = IsMine(state);
                    var canOperate = CanOperateModule(state.Module);
                    <tr>
                        <td>@state.Module</td>
                        <td>@(state.IsLocked ? "LOCKED" : "FREE")</td>
                        <td>@(state.IsOnAir ? "SI" : "NO")</td>
                        <td>@(string.IsNullOrWhiteSpace(state.Owner) ? "-" : state.Owner)</td>
                        <td>@FormatUtc(state.LastActionUtc)</td>
                        <td>@(string.IsNullOrWhiteSpace(state.LastScene) ? "-" : state.LastScene)</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-2"
                                    type="button"
                                    @onclick="() => Acquire(state.Module)"
                                    disabled="@(!canOperate || (state.IsLocked && !mine))">
                                Lock
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    @onclick="() => Release(state.Module)"
                                    disabled="@(!canOperate || !mine)">
                                Unlock
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-12 col-xl-7">
        @if (TryGetSpecializedModule(out var specializedModule))
        {
            <h4>Atajos de @specializedModule</h4>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var shortcut in GetShortcuts(specializedModule))
                {
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => RunShortcutAsync(shortcut)"
                            disabled="@(!ModuleLockService.IsOwner(shortcut.Module, NormalizedOperatorId) || !CanOperateModule(shortcut.Module))">
                        @shortcut.Label
                    </button>
                }
            </div>

            <div class="border rounded p-3 mb-3">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label form-label-sm">Grafico activo (datos apoyo)</label>
                        <select class="form-select form-select-sm"
                                value="@GetActiveGraphic(specializedModule)"
                                @onchange="args => OnActiveGraphicChanged(specializedModule, args)">
                            @foreach (var graphic in GetSupportGraphics(specializedModule))
                            {
                                <option value="@graphic">@graphic</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => RefreshSupportDataAsync(specializedModule)"
                                disabled="@supportDataLoading">
                            @(supportDataLoading ? "Cargando..." : "Refrescar tabla apoyo")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(supportDataError))
                {
                    <div class="alert alert-danger mt-2 mb-0" role="alert">@supportDataError</div>
                }
                else if (supportDataModule == specializedModule && supportDataRows.Count > 0)
                {
                    <div class="small text-muted mt-2">
                        Actualizado (UTC): @FormatUtc(supportDataUpdatedUtc)
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @if (IsActiveGraphic(specializedModule, "SEDES"))
                        {
                            <button class="btn btn-sm btn-outline-success"
                                    @onclick="() => RunSupportSedesAsync(specializedModule, false)"
                                    disabled="@(!CanUseSupportActions(specializedModule))">
                                Sedes Entra
                            </button>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => RunSupportSedesAsync(specializedModule, true)"
                                    disabled="@(!CanUseSupportActions(specializedModule))">
                                Sedes Encadena
                            </button>
                            <button class="btn btn-sm btn-outline-warning"
                                    @onclick="() => RunSupportCommandAsync(specializedModule, GraphicCommand.SedesSale)"
                                    disabled="@(!ModuleLockService.IsOwner(specializedModule, NormalizedOperatorId) || !CanOperateModule(specializedModule))">
                                Sedes Sale
                            </button>
                        }
                        @if (IsActiveGraphic(specializedModule, "ULTIMO ESCANO") && specializedModule == GraphicModule.Carton)
                        {
                            <button class="btn btn-sm btn-outline-success"
                                    @onclick="() => RunSupportUltimoAsync(true)"
                                    disabled="@(!CanUseSupportActions(specializedModule))">
                                Ultimo Entra Izq
                            </button>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => RunSupportUltimoAsync(false)"
                                    disabled="@(!CanUseSupportActions(specializedModule))">
                                Ultimo Entra Der
                            </button>
                            <button class="btn btn-sm btn-outline-warning"
                                    @onclick="() => RunSupportCommandAsync(specializedModule, GraphicCommand.UltimoLimpiaPartidos)"
                                    disabled="@(!ModuleLockService.IsOwner(specializedModule, NormalizedOperatorId) || !CanOperateModule(specializedModule))">
                                Ultimo Limpia
                            </button>
                        }
                    </div>

                    @if (GetSelectedSupportParty(specializedModule) is not null)
                    {
                        <div class="small text-muted mt-2">
                            @GetSelectedSupportPartyText(specializedModule)
                        </div>
                    }

                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Codigo</th>
                                    <th>Siglas</th>
                                    <th>Esc</th>
                                    <th>Desde</th>
                                    <th>Hasta</th>
                                    <th>Ultimo</th>
                                    <th>Siguiente</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var partido in GetFilteredSupportRows(specializedModule))
                                {
                                    <tr class="@(IsSupportRowSelected(specializedModule, partido) ? "table-primary" : null)"
                                        @onclick="() => OnSupportRowClick(specializedModule, partido)"
                                        @ondblclick="() => OnSupportRowDoubleClickAsync(specializedModule, partido)">
                                        <td>@partido.Codigo</td>
                                        <td>@partido.Siglas</td>
                                        <td>@GetDisplayEscanos(partido)</td>
                                        <td>@partido.EscaniosDesdeSondeo</td>
                                        <td>@partido.EscaniosHastaSondeo</td>
                                        <td>@(partido.EsUltimoEscano != 0 ? "Si" : "")</td>
                                        <td>@(partido.LuchaUltimoEscano != 0 ? "Si" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <h4>Botonera por modulo</h4>

        @foreach (var module in Enum.GetValues<GraphicModule>())
        {
            if (!ShowModule(module))
            {
                continue;
            }

            var owned = ModuleLockService.IsOwner(module, NormalizedOperatorId);
            var canOperate = CanOperateModule(module);
            var status = !canOperate ? "FORBIDDEN" : (owned ? "OWNED" : "READ ONLY");
            var statusCss = !canOperate ? "bg-danger" : (owned ? "bg-success" : "bg-secondary");

            <div class="border rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>@module</strong>
                    <span class="badge @statusCss">@status</span>
                </div>

                <div class="mb-2">
                    <label class="form-label form-label-sm">Escena</label>
                    <select class="form-select form-select-sm" @bind="selectedScenes[module]" disabled="@(!owned || !canOperate)">
                        @foreach (var scene in GetScenes(module))
                        {
                            <option value="@scene">@scene</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-info" @onclick="() => RunQuickActionAsync(module, OperationActionType.Prepare)" disabled="@(!owned || !canOperate)">PREPARA</button>
                    <button class="btn btn-sm btn-success" @onclick="() => RunQuickActionAsync(module, OperationActionType.Enter)" disabled="@(!owned || !canOperate)">ENTRA</button>
                    <button class="btn btn-sm btn-primary" @onclick="() => RunQuickActionAsync(module, OperationActionType.Update)" disabled="@(!owned || !canOperate)">ACTUALIZA</button>
                    <button class="btn btn-sm btn-warning" @onclick="() => RunQuickActionAsync(module, OperationActionType.Exit)" disabled="@(!owned || !canOperate)">SALE</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => RunQuickActionAsync(module, OperationActionType.Reset)" disabled="@(!owned || !canOperate)">RESET</button>
                </div>

                @if (GetCommands(module).Count > 0)
                {
                    <div class="mb-2">
                        <label class="form-label form-label-sm">Valor comando (opcional)</label>
                        <input class="form-control form-control-sm"
                               @bind="commandValues[module]"
                               placeholder="Codigo partido / valor de control"
                               disabled="@(!owned || !canOperate)" />
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var command in GetCommands(module))
                        {
                            <button class="btn btn-sm btn-outline-dark"
                                    @onclick="() => RunCommandAsync(module, command)"
                                    disabled="@(!owned || !canOperate)">
                                @GetCommandLabel(command)
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (lastResult is not null)
{
    <hr />
    <h4>Resultado</h4>
    <p><strong>CSV:</strong> @lastResult.CsvPath</p>
    <p><strong>Signal:</strong></p>
    <pre class="p-2 border rounded bg-light">@lastResult.Signal</pre>
    <p><strong>Targets:</strong> @(lastResult.DispatchedTargets.Count == 0 ? "None" : string.Join(", ", lastResult.DispatchedTargets))</p>
}

@code {
    private string operatorId = Environment.UserName;
    private string feedbackMessage = string.Empty;
    private bool feedbackIsError;

    private IReadOnlyList<ModuleLockInfo> moduleStates = [];
    private IReadOnlyList<CircunscripcionSummary> circunscripciones = [];
    private IReadOnlyList<MedioSummary> medios = [new("RTVE", "RTVE")];

    private GraphicsTarget selectedTarget = GraphicsTarget.Ipf;
    private SnapshotQueryKind queryKind = SnapshotQueryKind.Circunscripcion;
    private string selectedCircunscripcionCodigo = string.Empty;
    private string selectedMedioCodigo = "RTVE";
    private string autonomiaCodigo = string.Empty;
    private string partidoCodigo = string.Empty;
    private int selectedAvance;
    private int selectedElectionSlot = 1;
    private int numEleccionesSimultaneas = 1;
    private int selectedConnectionType;
    private int sceneSeconds;
    private bool includeZeroSeats;
    private OperationalHoursOptions operationHours = new();
    private bool autoRefreshEnabled;
    private int autoRefreshIntervalSeconds = 5;
    private bool autoRefreshRunning;
    private DateTime? lastAutoRefreshCheckUtc;
    private DateTime? lastAutoRefreshAppliedUtc;
    private string autoRefreshStatusMessage = string.Empty;
    private bool autoRefreshStatusIsError;
    private string? lastAutoRefreshFingerprint;
    private CancellationTokenSource? autoRefreshCts;
    private Task? autoRefreshLoopTask;
    private IEnumerable<int> availableElectionSlots => Enumerable.Range(1, Math.Clamp(numEleccionesSimultaneas, 1, 3));
    private bool RequiresAutonomia => queryKind is SnapshotQueryKind.MasVotadosProvincias or SnapshotQueryKind.PartidoProvincias;
    private bool RequiresPartido => queryKind is SnapshotQueryKind.PartidoAutonomias or SnapshotQueryKind.PartidoProvincias;

    private bool oficiales;
    private string exportName = "BrainStorm";

    private readonly Dictionary<GraphicModule, string[]> moduleScenes = new()
    {
        [GraphicModule.Faldon] = ["Escrutinio", "Sondeo", "TICKER", "Pactometro", "SEDES", "CuentaAtras"],
        [GraphicModule.Carton] = ["PARTICIPACION", "CCAA_CARTONES", "CARRUSEL", "MAYORIAS", "CARTON_PARTIDOS", "ULTIMO_ESCANO"],
        [GraphicModule.Superfaldon] = ["SUPERFALDON", "ULTIMOESCANO", "SEDES"]
    };

    private readonly Dictionary<GraphicModule, GraphicCommand[]> moduleCommands = new()
    {
        [GraphicModule.Faldon] =
        [
            GraphicCommand.TickerVotosEntra,
            GraphicCommand.TickerVotosSale,
            GraphicCommand.TickerHistoricosEntra,
            GraphicCommand.TickerHistoricosSale,
            GraphicCommand.TickerFotosEntra,
            GraphicCommand.TickerFotosSale,
            GraphicCommand.TickerTDEntra,
            GraphicCommand.TickerTDActualiza,
            GraphicCommand.TickerTDSale,
            GraphicCommand.VideoIn,
            GraphicCommand.VideoOut,
            GraphicCommand.VideoInTodos,
            GraphicCommand.VideoOutTodos,
            GraphicCommand.SedesEntra,
            GraphicCommand.SedesEncadena,
            GraphicCommand.SedesSale,
            GraphicCommand.PactosEntra,
            GraphicCommand.PactosSale,
            GraphicCommand.PactosReinicio,
            GraphicCommand.PactosEntraIzquierda,
            GraphicCommand.PactosEntraDerecha,
            GraphicCommand.PactosSaleIzquierda,
            GraphicCommand.PactosSaleDerecha,
            GraphicCommand.PrimerosResultadosActiva,
            GraphicCommand.PrimerosResultadosDesactiva,
            GraphicCommand.AnimacionSondeoActiva,
            GraphicCommand.AnimacionSondeoDesactiva,
            GraphicCommand.DeSondeoAOficiales,
            GraphicCommand.CambioEleccionesEuropa,
            GraphicCommand.CambioEleccionesNacional,
            GraphicCommand.PrimeSubirRotulosTD,
            GraphicCommand.PrimeBajarRotulosTD,
            GraphicCommand.PrimeSubirRotulosEspeciales,
            GraphicCommand.PrimeBajarRotulosEspeciales
        ],
        [GraphicModule.Carton] =
        [
            GraphicCommand.UltimoLimpiaPartidos,
            GraphicCommand.UltimoEntraPartidoIzquierda,
            GraphicCommand.UltimoEntraPartidoDerecha
        ],
        [GraphicModule.Superfaldon] =
        [
            GraphicCommand.SedesEntra,
            GraphicCommand.SedesEncadena,
            GraphicCommand.SedesSale
        ]
    };

    private readonly Dictionary<GraphicModule, string> selectedScenes = new();
    private readonly Dictionary<GraphicModule, string> commandValues = new();
    private readonly Dictionary<GraphicModule, string> activeGraphics = new();

    private OperationResult? lastResult;
    private IReadOnlyList<PartidoSnapshot> supportDataRows = [];
    private GraphicModule? supportDataModule;
    private DateTime? supportDataUpdatedUtc;
    private readonly Dictionary<GraphicModule, string> selectedSupportPartyCodes = new();
    private bool supportDataLoading;
    private string supportDataError = string.Empty;
    [Parameter] public string? moduleHint { get; set; }

    private string NormalizedOperatorId => operatorId.Trim();
    private string CurrentRole => AuthorizationService.GetRole(NormalizedOperatorId);
    private string AllowedModulesText
    {
        get
        {
            var modules = AuthorizationService.GetAllowedModules(NormalizedOperatorId);
            return modules.Count == 0 ? "-" : string.Join(", ", modules);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        operatorId = await ResolveAuthenticatedOperatorIdAsync();
        numEleccionesSimultaneas = ResolveIntFromConfig("Database:NumEleccionesSimultaneas", 1, 1, 3);
        selectedElectionSlot = ResolveIntFromConfig("Database:DefaultElectionSlot", 1, 1, numEleccionesSimultaneas);
        operationHours = LoadOperationalHoursFromConfig();

        moduleStates = ModuleLockService.GetStates();
        ModuleLockService.LocksChanged += OnLocksChanged;

        await ReloadReferenceDataAsync();

        foreach (var module in Enum.GetValues<GraphicModule>())
        {
            selectedScenes[module] = GetScenes(module).FirstOrDefault() ?? string.Empty;
            commandValues[module] = string.Empty;
            activeGraphics[module] = GetSupportGraphics(module).FirstOrDefault() ?? "FICHAS";
        }

        StartAutoRefreshLoop();
    }

    private async Task<string> ResolveAuthenticatedOperatorIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name?.Trim() ?? string.Empty;
    }

    private static IReadOnlyList<MedioSummary> BuildMediosForUi(IReadOnlyList<MedioSummary> loadedMedios)
    {
        var list = new List<MedioSummary> { new("RTVE", "RTVE") };
        list.AddRange(
            loadedMedios
                .Where(x => !string.IsNullOrWhiteSpace(x.Codigo))
                .Where(x => !string.Equals(x.Codigo, "RTVE", StringComparison.OrdinalIgnoreCase))
                .DistinctBy(x => x.Codigo)
                .Select(x => new MedioSummary(
                    x.Codigo.Trim(),
                    string.IsNullOrWhiteSpace(x.Descripcion) ? x.Codigo.Trim() : x.Descripcion.Trim())));
        return list;
    }

    private IEnumerable<string> GetScenes(GraphicModule module)
    {
        return moduleScenes.TryGetValue(module, out var scenes) ? scenes : ["CONTROL"];
    }

    private IReadOnlyList<GraphicCommand> GetCommands(GraphicModule module)
    {
        return moduleCommands.TryGetValue(module, out var commands) ? commands : [];
    }

    private bool ShowModule(GraphicModule module)
    {
        if (!TryGetSpecializedModule(out var specialized))
        {
            return true;
        }

        return module == specialized;
    }

    private bool TryGetSpecializedModule(out GraphicModule module)
    {
        module = default;
        if (string.IsNullOrWhiteSpace(moduleHint))
        {
            return false;
        }

        foreach (var value in Enum.GetValues<GraphicModule>())
        {
            if (string.Equals(moduleHint, value.ToString(), StringComparison.OrdinalIgnoreCase))
            {
                module = value;
                return true;
            }
        }

        return false;
    }

    private IReadOnlyList<ModuleLockInfo> GetVisibleModuleStates()
    {
        if (!TryGetSpecializedModule(out var module))
        {
            return moduleStates;
        }

        return moduleStates.Where(x => x.Module == module).ToList();
    }

    private string GetPageTitle()
    {
        return TryGetSpecializedModule(out var module)
            ? $"Operacion {module}"
            : "Operacion multioperador";
    }

