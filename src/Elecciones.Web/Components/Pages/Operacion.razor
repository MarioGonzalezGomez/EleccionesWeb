    private async Task OnSupportRowDoubleClickAsync(GraphicModule module, PartidoSnapshot partido)
    {
        selectedSupportPartyCodes[module] = partido.Codigo;
        var activeGraphic = GetActiveGraphic(module).ToUpperInvariant();

        if (activeGraphic == "SEDES")
