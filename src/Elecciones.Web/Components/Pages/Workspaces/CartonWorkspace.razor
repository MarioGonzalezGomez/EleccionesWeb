@page "/carton"
@page "/operacion/carton"
@attribute [Authorize]
@implements IDisposable
@using Elecciones.Application.Abstractions
@using System.Globalization
@using Elecciones.Application.Models
@using Elecciones.Application.Services
@using Elecciones.Infrastructure.Options
@using EleccionesWeb.Services
@using Microsoft.Extensions.Options
@inject IModuleLockService ModuleLockService
@inject IOperationService OperationService
@inject IEleccionesDataService DataService
@inject IOperatorAuthorizationService AuthorizationService
@inject ConfiguredOperatorAuthorizationService AuthConfig
@inject IGlobalOperationalSettingsService GlobalSettingsService
@inject IOperationStateService StateService
@inject IBrainStormCsvWriter CsvWriter
@inject IOptionsMonitor<StorageOptions> StorageMonitor
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Cartón</PageTitle>

<header class="ws-topbar">
    <div class="ws-topbar-cluster">
        <span class="ws-brand-mark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
            Cartón
        </span>
        <span class="ws-onair-pill @(moduleState.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
            <span class="ws-tally-dot"></span>
            @(moduleState.IsOnAir ? $"EN AIRE: {(string.IsNullOrWhiteSpace(moduleState.ActiveScene) ? ActiveSceneName : moduleState.ActiveScene)}" : "FUERA DE AIRE")
        </span>
        @if (moduleOficiales && EffectiveEscrutadoGeneral.HasValue)
        {
            <span class="ws-chip ws-chip-accent ws-mono">
                Escrutinio Gral.: <strong>@EffectiveEscrutadoGeneral.Value.ToString("0.00", EsCulture)%</strong>
            </span>
        }
        @if (!IsOwner)
        {
            <button class="ws-btn ws-btn-amber ws-btn-xs" type="button" @onclick="ClaimModuleLock">
                Tomar control
            </button>
        }
    </div>

    <div class="ws-topbar-cluster">
        <div class="ws-seg-group ws-seg-compact" role="group" aria-label="Modo de datos de Cartón">
            <button type="button"
                    class="ws-seg-btn @(moduleOficiales ? "active" : string.Empty)"
                    @onclick="() => SetModuleOficialesAsync(true)">
                Oficiales
            </button>
            <button type="button"
                    class="ws-seg-btn @(!moduleOficiales ? "active-amber" : string.Empty)"
                    @onclick="() => SetModuleOficialesAsync(false)">
                Sondeo
            </button>
        </div>

        <div class="ws-inline-field">
            <label for="carton-slot-select">Elección:</label>
            <select id="carton-slot-select"
                    class="form-select form-select-sm ws-select-slot"
                    value="@moduleElectionSlot"
                    @onchange="OnModuleElectionSlotChangedAsync">
                <option value="1">Elección 1</option>
                <option value="2">Elección 2</option>
                <option value="3">Elección 3</option>
            </select>
        </div>

        <div class="ws-inline-field">
            <label for="carton-circ-select">Circunscripción:</label>
            <select id="carton-circ-select"
                    class="form-select form-select-sm ws-select-circ"
                    value="@selectedCircunscripcionCodigo"
                    @onchange="OnCircunscripcionChangedAsync">
                @foreach (var circ in circunscripciones)
                {
                    <option value="@circ.Codigo">@circ.Codigo - @circ.Nombre</option>
                }
            </select>
        </div>

        @if (!moduleOficiales)
        {
            <div class="ws-inline-field">
                <label for="carton-medio-select">Sondeo:</label>
                <select id="carton-medio-select"
                        class="form-select form-select-sm ws-select-medio"
                        value="@selectedMedioCodigo"
                        @onchange="OnMedioChangedAsync">
                    @foreach (var medio in medios)
                    {
                        <option value="@medio.Codigo">@medio.Descripcion</option>
                    }
                </select>
            </div>
        }

        <WorkspaceQuickNav Current="WorkspaceKind.Carton" OperatorId="@operatorId" />
    </div>
</header>

<div class="ws-body">
    <section class="ws-panel @(moduleState.IsOnAir ? "ws-panel-live" : string.Empty)">

        @if (!string.IsNullOrWhiteSpace(feedbackMessage))
        {
            <div class="ws-banner @(feedbackIsError ? "ws-banner-error" : "ws-banner-success") mb-3" role="status">
                <div class="d-flex align-items-center gap-2">
                    @if (feedbackIsError)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    }
                    <span>@feedbackMessage</span>
                </div>
                <button type="button" class="ws-icon-btn" aria-label="Cerrar mensaje" @onclick="() => feedbackMessage = string.Empty">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <div class="ws-tabs mb-0">
                @foreach (var kind in Enum.GetValues<CartonKind>())
                {
                    <button type="button"
                            class="ws-tab-btn @(activeKind == kind ? "active" : null)"
                            @onclick="() => SelectKindAsync(kind)">
                        @GetCartonLabel(kind)
                    </button>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @foreach (var csvInfo in ActiveCsvTargets)
                {
                    <span class="ws-chip ws-mono" title="Archivo CSV específico generado por este cartón">
                        <span class="text-muted">@csvInfo.Role:</span>
                        <strong>@csvInfo.FileName</strong>
                    </span>
                }
            </div>
        </div>

        <SceneActionBar SceneLabel="@ActiveSceneName"
                        UpdateLabel="@(activeKind == CartonKind.Participacion ? "ENCADENA" : "ACTUALIZA")"
                        Oficiales="@moduleOficiales"
                        EscrutadoGeneral="@EffectiveEscrutadoGeneral"
                        EscrutadoCircunscripcion="@currentSnapshot?.Escrutado"
                        IsSubCircunscripcion="@IsSubCircunscripcion"
                        Disabled="@(!CanExecute)"
                        OnAction="RunSceneActionAsync" />

        @switch (activeKind)
        {
            case CartonKind.Participacion:
                <div class="ws-subcard d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="small text-muted">
                        Cartón de <strong>Participación</strong> · Elección @moduleElectionSlot · @(globalSettings.Avance == 0 ? "Avance automático (según escrutinio)" : $"Avance {globalSettings.Avance}").
                    </div>
                    <span class="ws-chip ws-chip-accent">1 CSV específico (Participación)</span>
                </div>
                break;

            case CartonKind.Mayorias:
                <div class="ws-subcard d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="ws-control-group-title mb-1">Cartón de Mayorías (Doble CSV: Partidos + Provincia)</div>
                        <div class="small text-muted">
                            Circunscripción activa: <strong>@(currentSnapshot?.Circunscripcion.Nombre ?? selectedCircunscripcionCodigo)</strong>
                            @if (currentSnapshot is { EscaniosTotales: > 0 })
                            {
                                <span> · Cámara: <strong>@currentSnapshot.EscaniosTotales esc.</strong> (Mayoría: <strong>@currentSnapshot.MayoriaAbsoluta</strong>)</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button class="ws-btn ws-btn-primary-outline"
                                type="button"
                                @onclick="() => RunCommandAsync(GraphicCommand.MayoriasSube, SelectedParty?.Codigo ?? string.Empty)"
                                disabled="@(!CanExecute)">
                            Mayorías Sube
                        </button>
                        <button class="ws-btn ws-btn-amber-outline"
                                type="button"
                                @onclick="() => RunCommandAsync(GraphicCommand.MayoriasBaja, SelectedParty?.Codigo ?? string.Empty)"
                                disabled="@(!CanExecute)">
                            Mayorías Baja
                        </button>
                    </div>
                </div>
                break;

            case CartonKind.Estatal:
                <div class="ws-subcard">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="ws-control-group-title mb-0">Cartón Estatal (Doble CSV: Partidos + Provincia)</div>
                        <span class="ws-chip ws-chip-accent">2 CSV (Partidos + Provincia)</span>
                    </div>
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-5">
                            <label for="carton-query-kind" class="form-label form-label-sm fw-semibold">Modo de consulta</label>
                            <select id="carton-query-kind" class="form-select form-select-sm" @bind="queryKind" @bind:after="LoadPartiesAsync">
                                <option value="@SnapshotQueryKind.Circunscripcion">Circunscripción / Total Estatal</option>
                                <option value="@SnapshotQueryKind.MasVotadosAutonomias">Más votados por Autonomías</option>
                                <option value="@SnapshotQueryKind.MasVotadosProvincias">Más votados por Provincias (CCAA)</option>
                                <option value="@SnapshotQueryKind.PartidoAutonomias">Partido por Autonomías</option>
                                <option value="@SnapshotQueryKind.PartidoProvincias">Partido por Provincias (CCAA)</option>
                            </select>
                        </div>

                        @if (RequiresAutonomia)
                        {
                            <div class="col-12 col-md-3">
                                <label for="carton-autonomia-input" class="form-label form-label-sm fw-semibold">Código Autonomía</label>
                                <input id="carton-autonomia-input" class="form-control form-control-sm" @bind="autonomiaCodigo" placeholder="Ej: 01" />
                            </div>
                        }

                        @if (RequiresPartido)
                        {
                            <div class="col-12 col-md-4">
                                <div class="small text-muted">Partido filtro (tabla inferior):</div>
                                <div class="fw-semibold">
                                    @if (SelectedParty is not null)
                                    {
                                        <span class="ws-party-pill">@SelectedParty.Siglas <span>(@SelectedParty.Codigo)</span></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Selecciona partido en la tabla inferior</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                break;

            case CartonKind.Cuadraditos:
                <div class="ws-subcard d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="ws-control-group-title mb-1">Cartón de Cuadraditos</div>
                        <div class="small text-muted">
                            Distribución gráfica de escaños · Circunscripción: <strong>@(currentSnapshot?.Circunscripcion.Nombre ?? selectedCircunscripcionCodigo)</strong>
                            @if (SelectedParty is not null)
                            {
                                <span> · Partido seleccionado: <strong>@SelectedParty.Siglas</strong></span>
                            }
                        </div>
                    </div>
                    <span class="ws-chip ws-chip-accent">1 CSV específico (Cuadraditos)</span>
                </div>
                break;

            case CartonKind.UltimoEscano:
                <div class="ws-subcard d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <div class="ws-control-group-title">Partido en disputa (selección en tabla inferior o doble clic)</div>
                        <div class="fw-semibold">
                            @if (SelectedParty is not null)
                            {
                                <span class="ws-party-pill">@SelectedParty.Siglas <span>(@SelectedParty.Codigo)</span></span>
                            }
                            else
                            {
                                <span class="text-muted">Selecciona un partido en la tabla inferior</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="ws-btn ws-btn-live"
                                type="button"
                                @onclick="() => RunPartyCommandAsync(GraphicCommand.UltimoEntraPartidoIzquierda)"
                                disabled="@(!CanExecute || SelectedParty is null)">
                            Último Entra Izq
                        </button>
                        <button class="ws-btn ws-btn-primary"
                                type="button"
                                @onclick="() => RunPartyCommandAsync(GraphicCommand.UltimoEntraPartidoDerecha)"
                                disabled="@(!CanExecute || SelectedParty is null)">
                            Último Entra Der
                        </button>
                        <button class="ws-btn ws-btn-amber"
                                type="button"
                                @onclick="() => RunCommandAsync(GraphicCommand.UltimoLimpiaPartidos)"
                                disabled="@(!CanExecute)">
                            Último Limpia
                        </button>
                    </div>
                </div>
                break;
        }
    </section>

    <PartySidebarTable Parties="@DisplayedParties"
                       Snapshot="@currentSnapshot"
                       SelectedPartyCode="@selectedPartyCode"
                       Oficiales="@moduleOficiales"
                       ShowUltimoIndicators="@(activeKind == CartonKind.UltimoEscano)"
                       Loading="@loadingParties"
                       OnPartySelected="OnPartySelected"
                       OnPartyDoubleClicked="OnPartyDoubleClickedAsync"
                       OnRefreshClicked="LoadPartiesAsync" />
</div>

@code {
    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-ES");
    private CartonKind activeKind = CartonKind.Participacion;
    private string operatorId = WorkspaceResolver.DefaultCartonOperator;
    private GlobalOperationalSettings globalSettings = new();
    private ModuleOperationalState moduleState = new() { Module = GraphicModule.Carton };
    private int moduleElectionSlot = 1;
    private bool moduleOficiales;

    private IReadOnlyList<CircunscripcionSummary> circunscripciones = [];
    private IReadOnlyList<MedioSummary> medios = [new("RTVE", "RTVE")];
    private IReadOnlyList<PartidoSnapshot> availableParties = [];
    private BrainStormSnapshot? currentSnapshot;

    private SnapshotQueryKind queryKind = SnapshotQueryKind.Circunscripcion;
    private string selectedCircunscripcionCodigo = string.Empty;
    private string selectedMedioCodigo = "RTVE";
    private string autonomiaCodigo = string.Empty;
    private string selectedPartyCode = string.Empty;
    private bool loadingParties;
    private string feedbackMessage = string.Empty;
    private bool feedbackIsError;

    private string ActiveSceneName => CartonKindResolver.ToDefaultSceneName(activeKind);

    private IReadOnlyList<(string Role, string FileName)> ActiveCsvTargets
    {
        get
        {
            var files = StorageMonitor.CurrentValue.CartonCsvFiles ?? new CartonCsvFilesOptions();
            return activeKind switch
            {
                CartonKind.Participacion => [("CSV", files.ParticipacionFileName)],
                CartonKind.Mayorias =>
                [
                    ("Partidos", files.MayoriasPartidosFileName),
                    ("Provincia", files.MayoriasProvinciaFileName)
                ],
                CartonKind.Estatal =>
                [
                    ("Partidos", files.EstatalPartidosFileName),
                    ("Provincia", files.EstatalProvinciaFileName)
                ],
                CartonKind.Cuadraditos => [("CSV", files.CuadraditosFileName)],
                CartonKind.UltimoEscano => [("CSV", files.UltimoEscanoFileName)],
                _ => [("CSV", files.ParticipacionFileName)]
            };
        }
    }

    private bool RequiresAutonomia => activeKind == CartonKind.Estatal
        && queryKind is SnapshotQueryKind.MasVotadosProvincias or SnapshotQueryKind.PartidoProvincias;

    private bool RequiresPartido => activeKind == CartonKind.Estatal
        && queryKind is SnapshotQueryKind.PartidoAutonomias or SnapshotQueryKind.PartidoProvincias;

    private IReadOnlyList<PartidoSnapshot> DisplayedParties => activeKind == CartonKind.UltimoEscano
        ? availableParties
            .OrderByDescending(p => p.EsUltimoEscano)
            .ThenByDescending(p => p.LuchaUltimoEscano)
            .ThenByDescending(GetDisplayEscanos)
            .ThenByDescending(p => p.PorcentajeVoto)
            .ThenByDescending(p => p.Votos)
            .ToList()
        : availableParties;

    private PartidoSnapshot? SelectedParty => availableParties.FirstOrDefault(p =>
        string.Equals(p.Codigo, selectedPartyCode, StringComparison.OrdinalIgnoreCase));

    private double? EffectiveEscrutadoGeneral => currentSnapshot is null
        ? null
        : (currentSnapshot.EscrutadoGeneral > 0 ? currentSnapshot.EscrutadoGeneral : currentSnapshot.Escrutado);

    private bool IsSubCircunscripcion => !string.IsNullOrWhiteSpace(selectedCircunscripcionCodigo)
        && !string.Equals(selectedCircunscripcionCodigo, "9900000", StringComparison.Ordinal);

    private bool CanOperate => AuthorizationService.CanOperate(operatorId, GraphicModule.Carton);
    private bool IsOwner => ModuleLockService.IsOwner(GraphicModule.Carton, operatorId);
    private bool CanExecute => CanOperate && IsOwner;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operatorId = WorkspaceResolver.ResolveEffectiveOperatorId(
            WorkspaceKind.Carton,
            authState.User.Identity?.Name,
            AuthConfig.AutoLoginByWorkspace);

        globalSettings = GlobalSettingsService.GetSettings();
        moduleState = StateService.GetState(GraphicModule.Carton);
        moduleElectionSlot = moduleState.ElectionSlot;
        moduleOficiales = moduleState.Oficiales;
        if (moduleState.CartonKind.HasValue)
        {
            activeKind = moduleState.CartonKind.Value;
        }

        GlobalSettingsService.OnSettingsChanged += HandleGlobalSettingsChanged;
        StateService.OnStateChanged += HandleOperationalStateChanged;
        ModuleLockService.LocksChanged += HandleLocksChanged;

        EnsureAutoLock();
        await ReloadReferenceDataAsync();
        await LoadPartiesAsync();
    }

    private void EnsureAutoLock()
    {
        if (CanOperate && !IsOwner)
        {
            ModuleLockService.TryAcquire(GraphicModule.Carton, operatorId);
        }
    }

    private async Task ClaimModuleLock()
    {
        if (!CanOperate)
        {
            return;
        }

        ModuleLockService.ForceRelease(GraphicModule.Carton);
        var ok = ModuleLockService.TryAcquire(GraphicModule.Carton, operatorId);
        feedbackMessage = ok ? "Control de Cartón activo. Ficheros CSV sincronizados." : "No se pudo tomar el control.";
        feedbackIsError = !ok;

        if (ok && currentSnapshot is not null)
        {
            await SyncCartonSelectionAndFilesAsync(currentSnapshot);
        }
    }

    private static string GetCartonLabel(CartonKind kind) => kind switch
    {
        CartonKind.Participacion => "Participación",
        CartonKind.Mayorias => "Mayorías",
        CartonKind.Estatal => "Estatal",
        CartonKind.Cuadraditos => "Cuadraditos",
        CartonKind.UltimoEscano => "Último escaño",
        _ => kind.ToString()
    };

    private async Task SelectKindAsync(CartonKind kind)
    {
        var previousUsesSpecialQuery = activeKind == CartonKind.Estatal && queryKind != SnapshotQueryKind.Circunscripcion;
        activeKind = kind;
        var currentUsesSpecialQuery = activeKind == CartonKind.Estatal && queryKind != SnapshotQueryKind.Circunscripcion;

        if (previousUsesSpecialQuery != currentUsesSpecialQuery)
        {
            await LoadPartiesAsync();
        }
        else if (currentSnapshot is not null)
        {
            moduleState = StateService.SyncModuleSelection(
                GraphicModule.Carton,
                operatorId,
                activeKind,
                BuildQuery(),
                moduleOficiales,
                globalSettings.Target,
                globalSettings.ExportName);
        }
    }

    private async Task SetModuleOficialesAsync(bool oficiales)
    {
        if (moduleOficiales == oficiales)
        {
            return;
        }

        moduleOficiales = oficiales;
        moduleState = StateService.ConfigureModule(GraphicModule.Carton, moduleElectionSlot, moduleOficiales);
        await LoadPartiesAsync();
    }

    private async Task OnModuleElectionSlotChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var parsedSlot))
        {
            return;
        }

        var clamped = Math.Clamp(parsedSlot, 1, 3);
        if (clamped == moduleElectionSlot)
        {
            return;
        }

        moduleElectionSlot = clamped;
        moduleState = StateService.ConfigureModule(GraphicModule.Carton, moduleElectionSlot, moduleOficiales);
        await ReloadReferenceDataAsync();
        await LoadPartiesAsync();
    }

    private void OnPartySelected(PartidoSnapshot party)
    {
        selectedPartyCode = party.Codigo;
    }

    private async Task OnPartyDoubleClickedAsync(PartidoSnapshot party)
    {
        selectedPartyCode = party.Codigo;
        if (activeKind == CartonKind.UltimoEscano)
        {
            await RunPartyCommandAsync(GraphicCommand.UltimoEntraPartidoIzquierda);
        }
    }

    private async Task OnCircunscripcionChangedAsync(ChangeEventArgs args)
    {
        selectedCircunscripcionCodigo = args.Value?.ToString() ?? string.Empty;
        await LoadPartiesAsync();
    }

    private async Task OnMedioChangedAsync(ChangeEventArgs args)
    {
        selectedMedioCodigo = args.Value?.ToString() ?? "RTVE";
        await LoadPartiesAsync();
    }

    private async Task ReloadReferenceDataAsync()
    {
        var previousCirc = selectedCircunscripcionCodigo;
        var previousMedio = selectedMedioCodigo;

        circunscripciones = await DataService.GetCircunscripcionesAsync(moduleElectionSlot, globalSettings.ConnectionType);
        selectedCircunscripcionCodigo = circunscripciones.FirstOrDefault(x => x.Codigo == previousCirc)?.Codigo
            ?? circunscripciones.FirstOrDefault()?.Codigo
            ?? string.Empty;

        var loadedMedios = await DataService.GetMediosAsync(moduleElectionSlot, globalSettings.ConnectionType);
        var list = new List<MedioSummary> { new("RTVE", "RTVE") };
        list.AddRange(loadedMedios
            .Where(x => !string.IsNullOrWhiteSpace(x.Codigo) && !string.Equals(x.Codigo, "RTVE", StringComparison.OrdinalIgnoreCase))
            .DistinctBy(x => x.Codigo)
            .Select(x => new MedioSummary(x.Codigo.Trim(), string.IsNullOrWhiteSpace(x.Descripcion) ? x.Codigo.Trim() : x.Descripcion.Trim())));
        medios = list;
        selectedMedioCodigo = medios.FirstOrDefault(x => string.Equals(x.Codigo, previousMedio, StringComparison.OrdinalIgnoreCase))?.Codigo
            ?? "RTVE";
    }

    private async Task LoadPartiesAsync()
    {
        loadingParties = true;
        try
        {
            var query = BuildQuery();
            var snapshot = await DataService.GetSnapshotAsync(query, moduleOficiales);
            currentSnapshot = snapshot;
            availableParties = snapshot.Partidos
                .Where(x => !string.IsNullOrWhiteSpace(x.Codigo))
                .OrderByDescending(GetDisplayEscanos)
                .ThenByDescending(x => x.PorcentajeVoto)
                .ThenByDescending(x => x.Votos)
                .ToList();

            if (string.IsNullOrWhiteSpace(selectedPartyCode) || !availableParties.Any(p => string.Equals(p.Codigo, selectedPartyCode, StringComparison.OrdinalIgnoreCase)))
            {
                selectedPartyCode = DisplayedParties.FirstOrDefault()?.Codigo ?? string.Empty;
            }

            await SyncCartonSelectionAndFilesAsync(snapshot);
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error cargando partidos: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            loadingParties = false;
        }
    }

    private async Task RunSceneActionAsync(OperationActionType action)
    {
        EnsureAutoLock();
        var request = new OperationRequest
        {
            OperatorId = operatorId,
            Module = GraphicModule.Carton,
            CartonKind = activeKind,
            Scene = ActiveSceneName,
            Action = action,
            Command = GraphicCommand.None,
            Target = globalSettings.Target,
            Oficiales = moduleOficiales,
            ExportName = globalSettings.ExportName,
            Query = BuildQuery()
        };

        var result = await OperationService.ExecuteAsync(request);
        feedbackMessage = result.Message;
        feedbackIsError = !result.Success;
    }

    private async Task RunCommandAsync(GraphicCommand command, string commandValue = "")
    {
        EnsureAutoLock();
        var request = new OperationRequest
        {
            OperatorId = operatorId,
            Module = GraphicModule.Carton,
            CartonKind = activeKind,
            Scene = ActiveSceneName,
            Action = OperationActionType.Update,
            Command = command,
            CommandValue = commandValue,
            Target = globalSettings.Target,
            Oficiales = moduleOficiales,
            ExportName = globalSettings.ExportName,
            Query = BuildQuery()
        };

        var result = await OperationService.ExecuteAsync(request);
        feedbackMessage = result.Message;
        feedbackIsError = !result.Success;
    }

    private async Task RunPartyCommandAsync(GraphicCommand command)
    {
        if (SelectedParty is null)
        {
            return;
        }

        await RunCommandAsync(command, SelectedParty.Codigo);
    }

    private int GetDisplayEscanos(PartidoSnapshot p) => moduleOficiales ? p.Escanios : p.EscaniosHastaSondeo;

    private async Task SyncCartonSelectionAndFilesAsync(BrainStormSnapshot snapshot)
    {
        var query = BuildQuery();
        moduleState = StateService.SyncModuleSelection(
            GraphicModule.Carton,
            operatorId,
            activeKind,
            query,
            moduleOficiales,
            globalSettings.Target,
            globalSettings.ExportName);

        // Solo escribimos directamente desde la previsualización cuando el módulo está FUERA DE AIRE;
        // si está EN AIRE, los CSV en disco pertenecen a la emisión activa hasta pulsar ENTRA o ACTUALIZA.
        if (IsOwner && !moduleState.IsOnAir)
        {
            await CsvWriter.WriteAllCartonFilesAsync(snapshot, query, CancellationToken.None, GraphicModule.Carton);
            await CsvWriter.WriteRecuentosJsonAsync(snapshot, CancellationToken.None, GraphicModule.Carton);
        }
    }

    private SnapshotQuery BuildQuery()
    {
        var effectiveKind = activeKind == CartonKind.Estatal
            ? queryKind
            : SnapshotQueryKind.Circunscripcion;

        return new SnapshotQuery
        {
            ElectionSlot = moduleElectionSlot,
            ConnectionType = globalSettings.ConnectionType,
            Kind = effectiveKind,
            CircunscripcionCodigo = selectedCircunscripcionCodigo,
            AutonomiaCodigo = RequiresAutonomia ? autonomiaCodigo.Trim() : string.Empty,
            PartidoCodigo = RequiresPartido ? (SelectedParty?.Codigo ?? string.Empty) : string.Empty,
            Avance = globalSettings.Avance == 0 ? null : globalSettings.Avance,
            IncludeZeroSeats = globalSettings.IncludeZeroSeats,
            MedioCodigo = selectedMedioCodigo.Trim()
        };
    }

    private void HandleGlobalSettingsChanged(GlobalOperationalSettings updated)
    {
        _ = InvokeAsync(async () =>
        {
            var connChanged = updated.ConnectionType != globalSettings.ConnectionType;
            var queryFilterChanged = updated.IncludeZeroSeats != globalSettings.IncludeZeroSeats
                                     || updated.Avance != globalSettings.Avance;
            globalSettings = updated;

            if (connChanged)
            {
                await ReloadReferenceDataAsync();
            }

            if (connChanged || queryFilterChanged)
            {
                await LoadPartiesAsync();
            }

            StateHasChanged();
        });
    }

    private void HandleOperationalStateChanged(GraphicModule module, ModuleOperationalState state)
    {
        if (module != GraphicModule.Carton)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            var slotChanged = state.ElectionSlot != moduleElectionSlot;
            var modeChanged = state.Oficiales != moduleOficiales;
            moduleState = state;
            moduleElectionSlot = state.ElectionSlot;
            moduleOficiales = state.Oficiales;

            if (slotChanged)
            {
                await ReloadReferenceDataAsync();
            }

            if (slotChanged || modeChanged)
            {
                await LoadPartiesAsync();
            }

            StateHasChanged();
        });
    }

    private void HandleLocksChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GlobalSettingsService.OnSettingsChanged -= HandleGlobalSettingsChanged;
        StateService.OnStateChanged -= HandleOperationalStateChanged;
        ModuleLockService.LocksChanged -= HandleLocksChanged;
    }
}
