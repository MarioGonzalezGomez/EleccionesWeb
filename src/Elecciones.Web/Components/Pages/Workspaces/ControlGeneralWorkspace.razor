    private async Task CheckDatabaseChangesNowAsync()
    {
        checkingDbChanges = true;
        try
        {
            var count = await ChangeListenerService.CheckAndDispatchUpdatesOnceAsync();
            globalSnapshot = GlobalSettings.GetSettings();
            feedbackMessage = count > 0
                ? $"Actualización automática disparada ({count} señal(es))."
                : globalSnapshot.LastAutoRefreshStatus;
            feedbackIsError = false;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al comprobar BD: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            checkingDbChanges = false;
        }
    }

    private void ForceUnlockModule(GraphicModule module)
    {
        ModuleLockService.ForceRelease(module);
        feedbackMessage = $"Bloqueo de {module} liberado por administración.";
        feedbackIsError = false;
        RefreshStatesAndDiagnostics();
    }

    private async Task ResetModuleAsync(GraphicModule module)
    {
        ModuleLockService.ForceRelease(module);
        ModuleLockService.TryAcquire(module, currentOperatorId);
        try
        {
            var activeState = StateService.GetState(module);
            var query = activeState.ActiveQuery ?? new SnapshotQuery
            {
                ElectionSlot = globalSnapshot.ElectionSlot,
                ConnectionType = globalSnapshot.ConnectionType,
                Kind = SnapshotQueryKind.Circunscripcion,
                CircunscripcionCodigo = "9900000",
                Avance = globalSnapshot.Avance,
                IncludeZeroSeats = globalSnapshot.IncludeZeroSeats
            };

            var result = await OperationService.ExecuteAsync(new OperationRequest
            {
                OperatorId = currentOperatorId,
                Module = module,
                Action = OperationActionType.Reset,
                Command = GraphicCommand.None,
                Scene = string.IsNullOrWhiteSpace(activeState.ActiveScene) ? "ESCRUTINIO" : activeState.ActiveScene,
                Oficiales = globalSnapshot.Oficiales,
                Target = globalSnapshot.Target,
                Query = query,
                ExportName = globalSnapshot.ExportName
            });

            feedbackMessage = result.Message;
            feedbackIsError = !result.Success;
        }
        finally
        {
            ModuleLockService.Release(module, currentOperatorId);
            RefreshStatesAndDiagnostics();
        }
    }

    private async Task SaveConfigAsync()
    {
        saving = true;
        feedbackMessage = string.Empty;
        feedbackIsError = false;
        try
        {
            var result = await ConfigService.SaveAsync(new OperationalConfigurationSnapshot
            {
                GraphicsEndpoints = graphics,
                Operational = operational
            });

            feedbackMessage = result.Message;
            feedbackIsError = !result.Success;
            LoadTechnicalConfig();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CheckConnectivityAsync()
    {
        checkingConnectivity = true;
        feedbackMessage = string.Empty;
        feedbackIsError = false;
        try
        {
            connectivityStatuses = await ConfigService.CheckConnectivityAsync();
            feedbackMessage = "Comprobación de conectividad completada.";
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error comprobando conexiones: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            checkingConnectivity = false;
        }
    }

    private void RefreshDiagnostics()
    {
        entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
    }

    private void ClearDiagnostics()
    {
        DiagnosticsService.Clear();
        RefreshDiagnostics();
    }

    private void HandleGlobalSettingsChanged(GlobalOperationalSettings settings)
    {
        _ = InvokeAsync(() =>
        {
            globalSnapshot = settings;
            StateHasChanged();
        });
    }

    private void HandleModuleStateChanged(GraphicModule module, ModuleOperationalState state)
    {
        _ = InvokeAsync(() =>
        {
            RefreshStatesAndDiagnostics();
            StateHasChanged();
        });
    }

    private void HandleLocksChanged()
    {
        _ = InvokeAsync(() =>
        {
            lockStates = ModuleLockService.GetStates();
            StateHasChanged();
        });
    }

    private void HandleDiagnosticsChanged()
    {
        _ = InvokeAsync(() =>
        {
            entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        GlobalSettings.OnSettingsChanged -= HandleGlobalSettingsChanged;
        StateService.OnStateChanged -= HandleModuleStateChanged;
        ModuleLockService.LocksChanged -= HandleLocksChanged;
        DiagnosticsService.EntriesChanged -= HandleDiagnosticsChanged;
    }
}
