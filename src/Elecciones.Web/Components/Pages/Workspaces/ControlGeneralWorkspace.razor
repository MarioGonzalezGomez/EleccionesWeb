                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 2</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance2" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 2 Histórico</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance2Historico" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 3</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 3 Histórico</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance3Historico" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Participación</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraParticipacion" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Participación Histórica</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraParticipacionHistorico" />
                        </div>
                    </div>

                    <div class="ws-control-group-title">Fuentes de Vídeo (Slots 1-6)</div>
                    <table class="ws-table w-100 mb-0">
                        <thead>
                            <tr>
                                <th>Slot</th>
                                <th>Modo</th>
                                <th>Ruta / URL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in operational.VideoSources.OrderBy(x => x.Slot))
                            {
                                <tr>
                                    <td>@source.Slot</td>
                                    <td>
                                        <div class="form-check form-switch mb-0">
                                            <input id="@($"videoLive{source.Slot}")" class="form-check-input" type="checkbox" @bind="source.IsLive" />
                                            <label class="form-check-label small" for="@($"videoLive{source.Slot}")">
                                                @(source.IsLive ? "Directo" : "Pregrabado")
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm" @bind="source.Path" placeholder="Ruta local o URL" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (activeTab == ControlTab.Diagnostics)
    {
        <div class="ws-panel">
            <div class="row g-2 mb-2 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Filtrar por módulo</label>
                    <select class="form-select form-select-sm" @bind="selectedModuleFilter">
                        <option value="">Todos</option>
                        <option value="@GraphicModule.Faldon">Faldón</option>
                        <option value="@GraphicModule.Carton">Cartón</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Filtrar por destino</label>
                    <input class="form-control form-control-sm" placeholder="IPF, Prime..." @bind="targetFilter" />
                </div>
                <div class="col-12 col-md-6 d-flex gap-2">
                    <button type="button" class="ws-btn ws-btn-primary-outline" @onclick="RefreshDiagnostics">Refrescar</button>
                    <button type="button" class="ws-btn ws-btn-danger-outline" @onclick="ClearDiagnostics">Limpiar Consola</button>
                </div>
            </div>

            <div class="ws-diag-scroll">
                <table class="ws-table w-100 mb-0">
                    <thead>
                        <tr>
                            <th>Hora (UTC)</th>
                            <th>Módulo</th>
                            <th>Destino</th>
                            <th>Endpoint</th>
                            <th>Estado</th>
                            <th>Señal TCP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredEntries.Any())
                        {
                            @foreach (var entry in FilteredEntries)
                            {
                                <tr>
                                    <td class="text-nowrap ws-mono">@entry.TimestampUtc.ToString("HH:mm:ss.fff")</td>
                                    <td><span class="ws-chip ws-chip-accent">@(entry.Module?.ToString() ?? "-")</span></td>
                                    <td>@entry.EndpointName</td>
                                    <td class="ws-mono text-muted">@entry.Host:@entry.Port</td>
                                    <td>
                                        <span class="ws-chip @(entry.Delivered ? "ws-chip-live" : "ws-chip-danger")">
                                            @(entry.Delivered ? "OK" : "ERROR")
                                        </span>
                                    </td>
                                    <td>
                                        <code>@entry.Payload</code>
                                        @if (!entry.Delivered && !string.IsNullOrWhiteSpace(entry.StatusMessage))
                                        {
                                            <div class="ws-status-msg-error mt-1">@entry.StatusMessage</div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hay entradas de diagnóstico para el filtro actual.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</main>

@code {
    private enum ControlTab
    {
        GlobalLive,
        ElectionsAndDb,
        TechnicalConfig,
        Diagnostics
    }

    private static readonly GraphicModule[] SupervisedModules = [GraphicModule.Faldon, GraphicModule.Carton];
    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-ES");
    private readonly Dictionary<int, double> escrutadoBySlot = new();

    private ControlTab activeTab = ControlTab.GlobalLive;
    private GlobalOperationalSettings globalSnapshot = new();
    private GraphicsEndpointsOptions graphics = new();
    private GraphicsEndpointOptions faldonIpf = new();
    private GraphicsEndpointOptions cartonIpf = new();
    private OperationalOptions operational = new();
    private StorageOptions storage = new();
    private DatabaseOptions database = new();
    private string faldonCsvFolderOverride = string.Empty;
    private string cartonCsvFolderOverride = string.Empty;
    private ModuleOperationalState faldonState = new() { Module = GraphicModule.Faldon };
    private ModuleOperationalState cartonState = new() { Module = GraphicModule.Carton };
    private IReadOnlyList<ModuleLockInfo> lockStates = [];
    private IReadOnlyList<SignalDiagnosticEntry> entries = [];
    private IReadOnlyList<EndpointConnectivityStatus> connectivityStatuses = [];
    private IReadOnlyList<EndpointConnectivityStatus> dbConnectivityStatuses = [];

    private int syncElectionSlot = 1;
    private bool syncOficiales;

    private string currentOperatorId = "op_admin";
    private string feedbackMessage = string.Empty;
    private bool feedbackIsError;
    private bool saving;
    private bool checkingConnectivity;
    private bool checkingMySql;
    private bool checkingDbChanges;
    private string selectedModuleFilter = string.Empty;
    private string targetFilter = string.Empty;
    private IDisposable? dbOptionsSubscription;

    private DatabaseOptions LiveDatabaseOptions => DatabaseMonitor.CurrentValue;
    private IReadOnlyList<ActiveElectionDescriptor> ActiveElections => LiveDatabaseOptions.GetActiveElections();

    private IEnumerable<SignalDiagnosticEntry> FilteredEntries => entries
        .Where(e => string.IsNullOrWhiteSpace(selectedModuleFilter) || string.Equals(e.Module?.ToString(), selectedModuleFilter, StringComparison.OrdinalIgnoreCase))
        .Where(e => string.IsNullOrWhiteSpace(targetFilter) || e.EndpointName.Contains(targetFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(userName))
        {
            currentOperatorId = userName;
        }

        globalSnapshot = GlobalSettings.GetSettings();
        LoadTechnicalConfig();
        RefreshStatesAndDiagnostics();
        await RefreshEscrutadoBySlotAsync();
        syncElectionSlot = LiveDatabaseOptions.ClampSlot(faldonState.ElectionSlot);
        syncOficiales = faldonState.Oficiales;

        GlobalSettings.OnSettingsChanged += HandleGlobalSettingsChanged;
        StateService.OnStateChanged += HandleModuleStateChanged;
        ModuleLockService.LocksChanged += HandleLocksChanged;
        DiagnosticsService.EntriesChanged += HandleDiagnosticsChanged;
        ConfigService.ConfigurationChanged += HandleConfigurationChanged;
        dbOptionsSubscription = DatabaseMonitor.OnChange(_ => HandleConfigurationChanged());
    }

    private void LoadTechnicalConfig()
    {
        var snapshot = ConfigService.GetSnapshot();
        graphics = snapshot.GraphicsEndpoints;
        faldonIpf = graphics.ResolveIpfForModule(GraphicModule.Faldon);
        cartonIpf = graphics.ResolveIpfForModule(GraphicModule.Carton);
        operational = snapshot.Operational;
        storage = snapshot.Storage;
        database = snapshot.Database;
        faldonCsvFolderOverride = storage.ResolveCsvFolderOverride("Faldon");
        cartonCsvFolderOverride = storage.ResolveCsvFolderOverride("Carton");
    }

    private void RefreshStatesAndDiagnostics()
    {
        faldonState = StateService.GetState(GraphicModule.Faldon);
        cartonState = StateService.GetState(GraphicModule.Carton);
        lockStates = ModuleLockService.GetStates();
        entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
    }

    private async Task RefreshEscrutadoBySlotAsync()
    {
        escrutadoBySlot.Clear();
        foreach (var elec in ActiveElections)
        {
            try
            {
                var snap = await DataService.GetSnapshotAsync(new SnapshotQuery
                {
                    ElectionSlot = elec.Slot,
                    ConnectionType = globalSnapshot.ConnectionType,
                    Kind = SnapshotQueryKind.Circunscripcion,
                    CircunscripcionCodigo = "9900000"
                }, oficiales: true);

                escrutadoBySlot[elec.Slot] = snap.EscrutadoGeneral > 0 ? snap.EscrutadoGeneral : snap.Escrutado;
            }
            catch
            {
                escrutadoBySlot[elec.Slot] = 0;
            }
        }
    }

    private string FormatEscrutadoSlot(int slot)
        => escrutadoBySlot.TryGetValue(slot, out var val) ? val.ToString("0.00", EsCulture) : "0,00";

    private string GetElectionLabel(int slot)
        => LiveDatabaseOptions.GetElectionLabel(slot);

    private ModuleLockInfo GetModuleLockInfo(GraphicModule module) =>
        lockStates.FirstOrDefault(x => x.Module == module) ?? new ModuleLockInfo { Module = module };

    private static string GetConnectionLabel(int connectionType) => connectionType switch
    {
        0 => "BD Por Defecto",
        1 => "BD Principal",
        2 => "BD Reserva",
        3 => "BD Local",
        _ => $"Conn {connectionType}"
    };

    private async Task OnConnectionTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var conn))
        {
            GlobalSettings.UpdateSettings(s => s with { ConnectionType = conn });
            await RefreshEscrutadoBySlotAsync();
        }
    }

    private void OnTargetChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<GraphicsTarget>(e.Value?.ToString(), out var target))
        {
            GlobalSettings.UpdateSettings(s => s with { Target = target });
        }
    }

    private void OnAvanceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var avance))
        {
            GlobalSettings.UpdateSettings(s => s with { Avance = avance });
        }
    }

    private void OnExportNameChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(name))
        {
            GlobalSettings.UpdateSettings(s => s with { ExportName = name.Trim() });
        }
    }

    private void OnIncludeZeroSeatsChanged(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        GlobalSettings.UpdateSettings(s => s with { IncludeZeroSeats = enabled });
    }

    private void SyncBothModules()
    {
        var clampedSlot = LiveDatabaseOptions.ClampSlot(syncElectionSlot);
        syncElectionSlot = clampedSlot;
        StateService.SyncAllModules(clampedSlot, syncOficiales);
        GlobalSettings.UpdateSettings(s => s with
        {
            ElectionSlot = clampedSlot,
            Oficiales = syncOficiales
        });
        RefreshStatesAndDiagnostics();
        feedbackMessage = $"Faldón y Cartón sincronizados a {GetElectionLabel(clampedSlot)} · {(syncOficiales ? "Oficiales" : "Sondeo")}.";
        feedbackIsError = false;
    }

    private void OnSupervisedModuleSlotChanged(GraphicModule module, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var slot))
        {
            return;
        }

        var current = StateService.GetState(module);
        StateService.ConfigureModule(module, LiveDatabaseOptions.ClampSlot(slot), current.Oficiales);
        RefreshStatesAndDiagnostics();
    }

    private void SetSupervisedModuleOficiales(GraphicModule module, bool oficiales)
    {
        var current = StateService.GetState(module);
        StateService.ConfigureModule(module, current.ElectionSlot, oficiales);
        RefreshStatesAndDiagnostics();
    }

    private async Task OnSupervisedModuleLanguageChangedAsync(GraphicModule module, ChangeEventArgs e)
    {
        if (!Enum.TryParse<GraphicLanguage>(e.Value?.ToString(), out var selectedLang))
        {
            return;
        }

        var existingLock = GetModuleLockInfo(module);
        var operatorForCmd = existingLock.IsLocked && !string.IsNullOrWhiteSpace(existingLock.Owner)
            ? existingLock.Owner
            : currentOperatorId;
        var acquiredTempLock = !existingLock.IsLocked && ModuleLockService.TryAcquire(module, operatorForCmd);

        try
        {
            var st = StateService.GetState(module);
            var result = await OperationService.ExecuteAsync(new OperationRequest
            {
                OperatorId = operatorForCmd,
                Module = module,
                Action = OperationActionType.Update,
                Command = selectedLang.ToGraphicCommand(),
                Oficiales = st.Oficiales,
                Target = globalSnapshot.Target,
                Query = st.ActiveQuery ?? new SnapshotQuery { ElectionSlot = st.ElectionSlot, CircunscripcionCodigo = "9900000" }
            });

            feedbackMessage = result.Message;
            feedbackIsError = !result.Success;
        }
        finally
        {
            if (acquiredTempLock)
            {
                ModuleLockService.Release(module, operatorForCmd);
            }
            RefreshStatesAndDiagnostics();
        }
    }

    private void OnAutoRefreshEnabledChanged(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        GlobalSettings.UpdateSettings(s => s with { AutoRefreshEnabled = enabled });
    }

    private void OnAutoRefreshIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var interval))
        {
            GlobalSettings.UpdateSettings(s => s with { AutoRefreshIntervalSeconds = Math.Clamp(interval, 2, 60) });
        }
    }

    private async Task CheckDatabaseChangesNowAsync()
    {
        checkingDbChanges = true;
        try
        {
            var count = await ChangeListenerService.CheckAndDispatchUpdatesOnceAsync();
            globalSnapshot = GlobalSettings.GetSettings();
            await RefreshEscrutadoBySlotAsync();
            feedbackMessage = count > 0
                ? $"Actualización automática disparada ({count} señal(es))."
                : globalSnapshot.LastAutoRefreshStatus;
            feedbackIsError = false;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al comprobar BD: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            checkingDbChanges = false;
        }
    }

    private void ForceUnlockModule(GraphicModule module)
    {
        ModuleLockService.ForceRelease(module);
        feedbackMessage = $"Bloqueo de {module} liberado por administración.";
        feedbackIsError = false;
        RefreshStatesAndDiagnostics();
    }

    private async Task ResetModuleAsync(GraphicModule module)
    {
        ModuleLockService.ForceRelease(module);
        ModuleLockService.TryAcquire(module, currentOperatorId);
        try
        {
            var activeState = StateService.GetState(module);
            var query = activeState.ActiveQuery ?? new SnapshotQuery
            {
                ElectionSlot = activeState.ElectionSlot,
                ConnectionType = globalSnapshot.ConnectionType,
                Kind = SnapshotQueryKind.Circunscripcion,
                CircunscripcionCodigo = "9900000",
                Avance = globalSnapshot.Avance,
                IncludeZeroSeats = globalSnapshot.IncludeZeroSeats
            };

            var result = await OperationService.ExecuteAsync(new OperationRequest
            {
                OperatorId = currentOperatorId,
                Module = module,
                Action = OperationActionType.Reset,
                Command = GraphicCommand.None,
                Scene = string.IsNullOrWhiteSpace(activeState.ActiveScene) ? "ESCRUTINIO" : activeState.ActiveScene,
                Oficiales = activeState.Oficiales,
                Target = globalSnapshot.Target,
                Query = query,
                ExportName = globalSnapshot.ExportName
            });

            feedbackMessage = result.Message;
            feedbackIsError = !result.Success;
        }
        finally
        {
            ModuleLockService.Release(module, currentOperatorId);
            RefreshStatesAndDiagnostics();
        }
    }

    private async Task SaveConfigAsync()
    {
        saving = true;
        feedbackMessage = string.Empty;
        feedbackIsError = false;
        try
        {
            graphics.Ipf = new GraphicsEndpointOptions
            {
                Enabled = faldonIpf.Enabled,
                Host = string.IsNullOrWhiteSpace(faldonIpf.Host) ? "127.0.0.1" : faldonIpf.Host.Trim(),
                Port = faldonIpf.Port,
                Bd = string.IsNullOrWhiteSpace(faldonIpf.Bd) ? "dbs1" : faldonIpf.Bd.Trim()
            };
            graphics.SetModuleIpf(GraphicModule.Faldon, faldonIpf);
            graphics.SetModuleIpf(GraphicModule.Carton, cartonIpf);

            storage.CsvFoldersByModule["Faldon"] = faldonCsvFolderOverride?.Trim() ?? string.Empty;
            storage.CsvFoldersByModule["Carton"] = cartonCsvFolderOverride?.Trim() ?? string.Empty;

            var maxSlots = database.ClampedActiveCount;
            database.DefaultElectionSlot = Math.Clamp(database.DefaultElectionSlot, 1, maxSlots);

            var result = await ConfigService.SaveAsync(new OperationalConfigurationSnapshot
            {
                GraphicsEndpoints = graphics,
                Operational = operational,
                Storage = storage,
                Database = database
            });

            foreach (var mod in SupervisedModules)
            {
                var st = StateService.GetState(mod);
                if (st.ElectionSlot > maxSlots)
                {
                    StateService.ConfigureModule(mod, maxSlots, st.Oficiales);
                }
            }

            syncElectionSlot = Math.Clamp(syncElectionSlot, 1, maxSlots);
            feedbackMessage = result.Message;
            feedbackIsError = !result.Success;
            await RefreshEscrutadoBySlotAsync();
            RefreshStatesAndDiagnostics();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CheckConnectivityAsync()
    {
        checkingConnectivity = true;
        feedbackMessage = string.Empty;
        feedbackIsError = false;
        try
        {
            connectivityStatuses = await ConfigService.CheckConnectivityAsync();
            feedbackMessage = "Comprobación de conectividad Brainstorm / Prime completada.";
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error comprobando conexiones: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            checkingConnectivity = false;
        }
    }

    private async Task CheckDatabaseConnectivityAsync()
    {
        checkingMySql = true;
        feedbackMessage = string.Empty;
        feedbackIsError = false;
        try
        {
            dbConnectivityStatuses = await ConfigService.CheckDatabaseConnectivityAsync(database);
            var allOk = dbConnectivityStatuses.All(x => x.Reachable);
            feedbackMessage = allOk
                ? "Conexión MySQL verificada correctamente en todas las elecciones activas."
                : "Alguna base de datos MySQL no respondió. Revisa el detalle inferior.";
            feedbackIsError = !allOk;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error probando MySQL: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            checkingMySql = false;
        }
    }

    private void RefreshDiagnostics()
    {
        entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
    }

    private void ClearDiagnostics()
    {
        DiagnosticsService.Clear();
        RefreshDiagnostics();
    }

    private void HandleGlobalSettingsChanged(GlobalOperationalSettings settings)
    {
        _ = InvokeAsync(async () =>
        {
            var autoRefreshApplied = settings.LastAutoRefreshAppliedUtc != globalSnapshot.LastAutoRefreshAppliedUtc;
            globalSnapshot = settings;

            if (autoRefreshApplied)
            {
                await RefreshEscrutadoBySlotAsync();
            }

            StateHasChanged();
        });
    }

    private void HandleModuleStateChanged(GraphicModule module, ModuleOperationalState state)
    {
        _ = InvokeAsync(() =>
        {
            RefreshStatesAndDiagnostics();
            StateHasChanged();
        });
    }

    private void HandleLocksChanged()
    {
        _ = InvokeAsync(() =>
        {
            lockStates = ModuleLockService.GetStates();
            StateHasChanged();
        });
    }

    private void HandleDiagnosticsChanged()
    {
        _ = InvokeAsync(() =>
        {
            entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
            StateHasChanged();
        });
    }

    private void HandleConfigurationChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshEscrutadoBySlotAsync();
            RefreshStatesAndDiagnostics();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        GlobalSettings.OnSettingsChanged -= HandleGlobalSettingsChanged;
        StateService.OnStateChanged -= HandleModuleStateChanged;
        ModuleLockService.LocksChanged -= HandleLocksChanged;
        DiagnosticsService.EntriesChanged -= HandleDiagnosticsChanged;
        ConfigService.ConfigurationChanged -= HandleConfigurationChanged;
        dbOptionsSubscription?.Dispose();
    }
}
