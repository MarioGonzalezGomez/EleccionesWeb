@page "/admin"
@page "/control"
@page "/operacion"
@page "/operacion/admin"
@page "/operacion/diagnostico"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using Elecciones.Application.Abstractions
@using Elecciones.Application.Models
@using Elecciones.GraphicsGateway.Options
@using Elecciones.Infrastructure.Options
@using Elecciones.Infrastructure.Services
@using EleccionesWeb.Services
@using Microsoft.Extensions.Options
@inject IGlobalOperationalSettingsService GlobalSettings
@inject IOperationalConfigurationService ConfigService
@inject IOperationStateService StateService
@inject IModuleLockService ModuleLockService
@inject IOperationService OperationService
@inject IEleccionesDataService DataService
@inject ISignalDiagnosticsService DiagnosticsService
@inject DatabaseChangeListenerService ChangeListenerService
@inject IOptionsMonitor<DatabaseOptions> DatabaseMonitor
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Control General</PageTitle>

<header class="ws-topbar">
    <div class="ws-topbar-cluster">
        <span class="ws-brand-mark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
            Control General
        </span>
        <span class="ws-onair-pill @(faldonState.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
            <span class="ws-tally-dot"></span>
            FALDÓN: @(faldonState.IsOnAir ? faldonState.ActiveScene : "FUERA") · @(faldonState.Oficiales ? $"OFIC. ({FormatEscrutadoSlot(faldonState.ElectionSlot)}%)" : "SONDEO") · @GetElectionLabel(faldonState.ElectionSlot)
        </span>
        <span class="ws-onair-pill @(cartonState.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
            <span class="ws-tally-dot"></span>
            CARTÓN: @(cartonState.IsOnAir ? cartonState.ActiveScene : "FUERA") · @(cartonState.Oficiales ? $"OFIC. ({FormatEscrutadoSlot(cartonState.ElectionSlot)}%)" : "SONDEO") · @GetElectionLabel(cartonState.ElectionSlot)
        </span>
    </div>

    <div class="ws-topbar-cluster">
        <span class="ws-chip @(LiveDatabaseOptions.Enabled ? "ws-chip-live" : "ws-chip-amber")">
            @(LiveDatabaseOptions.Enabled ? $"MySQL Activo ({LiveDatabaseOptions.Host}:{LiveDatabaseOptions.Port})" : "Modo Demo (En Memoria)")
        </span>
        <span class="ws-chip ws-chip-accent">
            @GetConnectionLabel(globalSnapshot.ConnectionType) · @globalSnapshot.Target · Av.@globalSnapshot.Avance
        </span>
        <span class="ws-chip @(globalSnapshot.AutoRefreshEnabled ? "ws-chip-live" : "")">
            Auto-Refresh: @(globalSnapshot.AutoRefreshEnabled ? $"ON ({globalSnapshot.AutoRefreshIntervalSeconds}s)" : "OFF")
        </span>
        <WorkspaceQuickNav Current="WorkspaceKind.ControlGeneral" OperatorId="@currentOperatorId" />
    </div>
</header>

<main class="ws-main-container">
    <div class="ws-tabs">
        <button type="button" class="ws-tab-btn @(activeTab == ControlTab.GlobalLive ? "active" : "")" @onclick="() => activeTab = ControlTab.GlobalLive">
            Control Global (En Vivo)
        </button>
        <button type="button" class="ws-tab-btn @(activeTab == ControlTab.ElectionsAndDb ? "active" : "")" @onclick="() => activeTab = ControlTab.ElectionsAndDb">
            Elecciones y Base de Datos (@LiveDatabaseOptions.ClampedActiveCount)
        </button>
        <button type="button" class="ws-tab-btn @(activeTab == ControlTab.TechnicalConfig ? "active" : "")" @onclick="() => activeTab = ControlTab.TechnicalConfig">
            Configuración Técnica
        </button>
        <button type="button" class="ws-tab-btn @(activeTab == ControlTab.Diagnostics ? "active" : "")" @onclick="() => activeTab = ControlTab.Diagnostics">
            Diagnóstico TCP (@entries.Count)
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <div class="ws-banner @(feedbackIsError ? "ws-banner-error" : "ws-banner-success") d-flex justify-content-between align-items-center mb-3" role="alert">
            <span>@feedbackMessage</span>
            <button type="button" class="ws-icon-btn" aria-label="Cerrar mensaje" @onclick="() => feedbackMessage = string.Empty">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }

    @if (activeTab == ControlTab.GlobalLive)
    {
        <div class="row g-3">
            <div class="col-12 col-xl-7">
                <div class="ws-panel h-100">
                    <div class="ws-control-group-title">Parámetros Globales de Emisión</div>
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Servidor BD Activo</label>
                            <select class="form-select form-select-sm" value="@globalSnapshot.ConnectionType" @onchange="OnConnectionTypeChanged">
                                <option value="0">Por defecto</option>
                                <option value="1">Principal</option>
                                <option value="2">Reserva</option>
                                <option value="3">Local</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Motor Gráfico (Target)</label>
                            <select class="form-select form-select-sm" value="@globalSnapshot.Target" @onchange="OnTargetChanged">
                                <option value="@GraphicsTarget.Ipf">IPF</option>
                                <option value="@GraphicsTarget.Prime">Prime</option>
                                <option value="@GraphicsTarget.Both">Ambos (IPF + Prime)</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Avance Participación</label>
                            <select class="form-select form-select-sm" value="@globalSnapshot.Avance" @onchange="OnAvanceChanged">
                                <option value="0">Automático / Final (0)</option>
                                <option value="1">Avance 1</option>
                                <option value="2">Avance 2</option>
                                <option value="3">Avance 3</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Nombre Exportación Faldón</label>
                            <input class="form-control form-control-sm" value="@globalSnapshot.ExportName" @onchange="OnExportNameChanged" />
                        </div>
                        <div class="col-12 mt-2">
                            <div class="form-check form-switch">
                                <input id="chkZeroSeats" class="form-check-input" type="checkbox" checked="@globalSnapshot.IncludeZeroSeats" @onchange="OnIncludeZeroSeatsChanged" />
                                <label class="form-check-label small" for="chkZeroSeats">Incluir partidos con 0 escaños en tablas y exportaciones de Faldón</label>
                            </div>
                        </div>
                    </div>

                    <div class="ws-subcard mt-3">
                        <div class="ws-control-group-title mb-2">Sincronización Puntual a Ambos Módulos (Faldón + Cartón)</div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <div class="ws-inline-field">
                                <label for="sync-slot-select">Elección:</label>
                                <select id="sync-slot-select"
                                        class="form-select form-select-sm ws-select-slot"
                                        disabled="@(ActiveElections.Count <= 1)"
                                        @bind="syncElectionSlot">
                                    @foreach (var elec in ActiveElections)
                                    {
                                        <option value="@elec.Slot">@elec.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="ws-seg-group ws-seg-compact" role="group" aria-label="Modo a sincronizar">
                                <button type="button" class="ws-seg-btn @(syncOficiales ? "active" : "")" @onclick="() => syncOficiales = true">
                                    Oficiales
                                </button>
                                <button type="button" class="ws-seg-btn @(!syncOficiales ? "active-amber" : "")" @onclick="() => syncOficiales = false">
                                    Sondeo
                                </button>
                            </div>
                            <button type="button" class="ws-btn ws-btn-primary-outline ms-auto" @onclick="SyncBothModules">
                                Aplicar a Faldón y Cartón
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="ws-panel h-100">
                    <div class="ws-control-group-title">Auto-Refresh de Base de Datos (Servidor)</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input id="chkAutoRefresh" class="form-check-input" type="checkbox" checked="@globalSnapshot.AutoRefreshEnabled" @onchange="OnAutoRefreshEnabledChanged" />
                                <label class="form-check-label small fw-semibold" for="chkAutoRefresh">
                                    @(globalSnapshot.AutoRefreshEnabled ? "Auto-Refresh Activo" : "Auto-Refresh Pausado")
                                </label>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Intervalo (2 - 60 seg)</label>
                            <input type="number" min="2" max="60" class="form-control form-control-sm ws-num" value="@globalSnapshot.AutoRefreshIntervalSeconds" @onchange="OnAutoRefreshIntervalChanged" />
                        </div>
                        <div class="col-12 mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="small text-muted ws-mono">
                                <div><strong>Última comprobación:</strong> @(globalSnapshot.LastAutoRefreshCheckUtc?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</div>
                                <div><strong>Última actualización:</strong> @(globalSnapshot.LastAutoRefreshAppliedUtc?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</div>
                                <div class="font-sans"><strong>Estado:</strong> @(string.IsNullOrWhiteSpace(globalSnapshot.LastAutoRefreshStatus) ? "-" : globalSnapshot.LastAutoRefreshStatus)</div>
                            </div>
                            <button type="button" class="ws-btn ws-btn-primary-outline ws-btn-xs" @onclick="CheckDatabaseChangesNowAsync" disabled="@checkingDbChanges">
                                @(checkingDbChanges ? "Comprobando..." : "Comprobar BD ahora")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            @foreach (var module in SupervisedModules)
            {
                var state = StateService.GetState(module);
                var lockInfo = GetModuleLockInfo(module);
                var moduleLabel = module == GraphicModule.Faldon ? "FALDÓN" : "CARTÓN";
                <div class="col-12 col-md-6">
                    <div class="ws-panel @(state.IsOnAir ? "ws-panel-live" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <span class="ws-control-group-title mb-0">Supervisión @moduleLabel</span>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (state.Oficiales)
                                {
                                    <span class="ws-chip ws-chip-accent ws-mono">
                                        Escrutinio Gral.: <strong>@FormatEscrutadoSlot(state.ElectionSlot)%</strong>
                                    </span>
                                }
                                <span class="ws-onair-pill @(state.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
                                    <span class="ws-tally-dot"></span> @(state.IsOnAir ? "EN AIRE" : "FUERA DE AIRE")
                                </span>
                            </div>
                        </div>

                        <div class="ws-subcard mb-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div class="ws-inline-field">
                                    <label>Elección @moduleLabel:</label>
                                    <select class="form-select form-select-sm ws-select-slot"
                                            value="@LiveDatabaseOptions.ClampSlot(state.ElectionSlot)"
                                            disabled="@(ActiveElections.Count <= 1)"
                                            @onchange="e => OnSupervisedModuleSlotChanged(module, e)">
                                        @foreach (var elec in ActiveElections)
                                        {
                                            <option value="@elec.Slot">@elec.Label</option>
                                        }
                                    </select>
                                </div>

                                <div class="ws-inline-field">
                                    <label>Idioma:</label>
                                    <select class="form-select form-select-sm ws-select-lang"
                                            value="@state.GraphicLanguage"
                                            @onchange="e => OnSupervisedModuleLanguageChangedAsync(module, e)">
                                        @foreach (var lang in Enum.GetValues<GraphicLanguage>())
                                        {
                                            <option value="@lang">@lang.ToDisplayName()</option>
                                        }
                                    </select>
                                </div>

                                <div class="ws-seg-group ws-seg-compact" role="group" aria-label="@($"Modo de datos de {moduleLabel}")">
                                    <button type="button"
                                            class="ws-seg-btn @(state.Oficiales ? "active" : "")"
                                            @onclick="() => SetSupervisedModuleOficiales(module, true)">
                                        Oficiales
                                    </button>
                                    <button type="button"
                                            class="ws-seg-btn @(!state.Oficiales ? "active-amber" : "")"
                                            @onclick="() => SetSupervisedModuleOficiales(module, false)">
                                        Sondeo
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="ws-kpi-grid mb-3">
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Escena activa</div>
                                <div class="ws-kpi-value">@(string.IsNullOrWhiteSpace(state.ActiveScene) ? "-" : state.ActiveScene)</div>
                            </div>
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Bloqueo (Lock)</div>
                                <div class="ws-kpi-value">@(lockInfo.IsLocked ? lockInfo.Owner : "Libre")</div>
                            </div>
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Elección / BD asociada</div>
                                <div class="ws-kpi-value">
                                    @GetElectionLabel(state.ElectionSlot)
                                    @if (LiveDatabaseOptions.Enabled)
                                    {
                                        <span class="text-muted ws-mono small">(@LiveDatabaseOptions.GetDatabaseName(state.ElectionSlot))</span>
                                    }
                                </div>
                            </div>
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Brainstorm asignado</div>
                                @{
                                    var modIpf = graphics.ResolveIpfForModule(module);
                                }
                                <div class="ws-kpi-value ws-mono">
                                    @(modIpf.Enabled ? $"{modIpf.Host}:{modIpf.Port} ({modIpf.Bd})" : "Desactivado (OFF)")
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="ws-btn ws-btn-amber-outline" @onclick="() => ForceUnlockModule(module)" disabled="@(!lockInfo.IsLocked)">
                                Forzar Desbloqueo
                            </button>
                            <button type="button" class="ws-btn ws-btn-danger-outline" @onclick="() => ResetModuleAsync(module)">
                                Reset Módulo
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == ControlTab.ElectionsAndDb)
    {
        <div class="row g-3">
            <div class="col-12 col-xl-7">
                <div class="ws-panel h-100">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <span class="ws-control-group-title mb-0">Elecciones Activas Simultáneas (1 a 3) y BD Asociada</span>
                        <div class="ws-seg-group ws-seg-compact" role="group" aria-label="Número de elecciones activas">
                            @for (var n = 1; n <= 3; n++)
                            {
                                var countVal = n;
                                <button type="button"
                                        class="ws-seg-btn @(database.NumEleccionesSimultaneas == countVal ? "active" : "")"
                                        @onclick="() => database.NumEleccionesSimultaneas = countVal">
                                    @(countVal == 1 ? "1 Elección" : $"{countVal} Elecciones")
                                </button>
                            }
                        </div>
                    </div>

                    <div class="ws-subcard mb-3">
                        <div class="row g-2 align-items-center fw-semibold small text-muted mb-2 d-none d-md-flex">
                            <div class="col-md-2">Slot</div>
                            <div class="col-md-4">Nombre Visible (UI)</div>
                            <div class="col-md-4">Base de Datos MySQL Real</div>
                            <div class="col-md-2">Cód. Reg.</div>
                        </div>

                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-12 col-md-2">
                                <span class="ws-chip ws-chip-accent ws-mono">Elección 1</span>
                            </div>
                            <div class="col-12 col-md-4">
                                <input class="form-control form-control-sm" @bind="database.Label1" placeholder="Ej: Congreso" />
                            </div>
                            <div class="col-8 col-md-4">
                                <input class="form-control form-control-sm ws-mono" @bind="database.Name" placeholder="Ej: generales_2026_congreso" />
                            </div>
                            <div class="col-4 col-md-2">
                                <input class="form-control form-control-sm ws-mono" @bind="database.CodigoRegionalBD1" placeholder="Ej: 01" />
                            </div>
                        </div>

                        @if (database.NumEleccionesSimultaneas >= 2)
                        {
                            <div class="row g-2 align-items-center mb-2">
                                <div class="col-12 col-md-2">
                                    <span class="ws-chip ws-chip-accent ws-mono">Elección 2</span>
                                </div>
                                <div class="col-12 col-md-4">
                                    <input class="form-control form-control-sm" @bind="database.Label2" placeholder="Ej: Senado" />
                                </div>
                                <div class="col-8 col-md-4">
                                    <input class="form-control form-control-sm ws-mono" @bind="database.Name2" placeholder="Ej: generales_2026_senado" />
                                </div>
                                <div class="col-4 col-md-2">
                                    <input class="form-control form-control-sm ws-mono" @bind="database.CodigoRegionalBD2" placeholder="Opcional" />
                                </div>
                            </div>
                        }

                        @if (database.NumEleccionesSimultaneas >= 3)
                        {
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-md-2">
                                    <span class="ws-chip ws-chip-accent ws-mono">Elección 3</span>
                                </div>
                                <div class="col-12 col-md-4">
                                    <input class="form-control form-control-sm" @bind="database.Label3" placeholder="Ej: Autonómicas" />
                                </div>
                                <div class="col-8 col-md-4">
                                    <input class="form-control form-control-sm ws-mono" @bind="database.Name3" placeholder="Ej: autonomicas_2026" />
                                </div>
                                <div class="col-4 col-md-2">
                                    <input class="form-control form-control-sm ws-mono" @bind="database.CodigoRegionalBD3" placeholder="Opcional" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row g-2 align-items-end">
                        <div class="col-6 col-md-5">
                            <label class="form-label form-label-sm mb-1">Tipo de ámbito electoral</label>
                            <select class="form-select form-select-sm" @bind="database.TipoElecciones">
                                <option value="1">Estatal / Nacional (9900000)</option>
                                <option value="2">Autonómico / Regional (filtra por Cód. Reg.)</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label form-label-sm mb-1">Elección inicial por defecto</label>
                            <select class="form-select form-select-sm" @bind="database.DefaultElectionSlot">
                                <option value="1">1 · @(string.IsNullOrWhiteSpace(database.Label1) ? "Elección 1" : database.Label1)</option>
                                @if (database.NumEleccionesSimultaneas >= 2)
                                {
                                    <option value="2">2 · @(string.IsNullOrWhiteSpace(database.Label2) ? "Elección 2" : database.Label2)</option>
                                }
                                @if (database.NumEleccionesSimultaneas >= 3)
                                {
                                    <option value="3">3 · @(string.IsNullOrWhiteSpace(database.Label3) ? "Elección 3" : database.Label3)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="form-check form-switch mb-1">
                                <input id="chkRegionalFilter" class="form-check-input" type="checkbox" @bind="database.Regional" />
                                <label class="form-check-label small" for="chkRegionalFilter">Forzar filtro regional</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="ws-panel h-100">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <span class="ws-control-group-title mb-0">Origen de Datos y Servidor MySQL</span>
                        <div class="ws-seg-group ws-seg-compact" role="group" aria-label="Origen de datos electoral">
                            <button type="button"
                                    class="ws-seg-btn @(database.Enabled ? "active" : "")"
                                    @onclick="() => database.Enabled = true">
                                MySQL Real
                            </button>
                            <button type="button"
                                    class="ws-seg-btn @(!database.Enabled ? "active-amber" : "")"
                                    @onclick="() => database.Enabled = false">
                                Demo (En Memoria)
                            </button>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label form-label-sm mb-1">Host Principal (IP / DNS)</label>
                            <input class="form-control form-control-sm ws-mono" @bind="database.Host" placeholder="192.168.1.100" />
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm mb-1">Puerto</label>
                            <input class="form-control form-control-sm ws-mono" type="number" min="1" @bind="database.Port" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Host Reserva (opcional)</label>
                            <input class="form-control form-control-sm ws-mono" @bind="database.HostBackup" placeholder="Vacío = no usar" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Host Local</label>
                            <input class="form-control form-control-sm ws-mono" @bind="database.HostLocal" placeholder="127.0.0.1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Usuario MySQL</label>
                            <input class="form-control form-control-sm ws-mono" @bind="database.User" autocomplete="off" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Contraseña MySQL</label>
                            <input class="form-control form-control-sm ws-mono" type="password" @bind="database.Password" autocomplete="new-password" placeholder="Vacío = usa var. entorno si existe" />
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="ws-btn ws-btn-primary" @onclick="SaveConfigAsync" disabled="@saving">
                            @(saving ? "Guardando..." : "Guardar Elecciones y BD")
                        </button>
                        <button type="button" class="ws-btn ws-btn-primary-outline" @onclick="CheckDatabaseConnectivityAsync" disabled="@checkingMySql">
                            @(checkingMySql ? "Probando MySQL..." : "Probar Conexión MySQL")
                        </button>
                    </div>

                    @if (dbConnectivityStatuses.Count > 0)
                    {
                        <div class="mt-3 d-flex flex-column gap-2">
                            @foreach (var status in dbConnectivityStatuses)
                            {
                                <div class="ws-chip @(status.Reachable ? "ws-chip-live" : "ws-chip-danger") justify-content-between">
                                    <span><strong>@status.Name</strong> (@status.Host:@status.Port)</span>
                                    <span>@status.Message</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (activeTab == ControlTab.TechnicalConfig)
    {
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <div class="ws-panel h-100">
