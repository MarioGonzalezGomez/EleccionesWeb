@page "/admin"
@page "/control"
@page "/operacion"
@page "/operacion/admin"
@page "/operacion/diagnostico"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using Elecciones.Application.Abstractions
@using Elecciones.Application.Models
@using Elecciones.GraphicsGateway.Options
@using Elecciones.Infrastructure.Options
@using Elecciones.Infrastructure.Services
@using EleccionesWeb.Services
@inject IGlobalOperationalSettingsService GlobalSettings
@inject IOperationalConfigurationService ConfigService
@inject IOperationStateService StateService
@inject IModuleLockService ModuleLockService
@inject IOperationService OperationService
@inject IEleccionesDataService DataService
@inject ISignalDiagnosticsService DiagnosticsService
@inject DatabaseChangeListenerService ChangeListenerService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Control General</PageTitle>

<header class="ws-topbar">
    <div class="ws-topbar-cluster">
        <span class="ws-brand-mark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
            Control General
        </span>
        <span class="ws-onair-pill @(faldonState.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
            <span class="ws-tally-dot"></span>
            FALDÓN: @(faldonState.IsOnAir ? faldonState.ActiveScene : "FUERA") · @(faldonState.Oficiales ? $"OFIC. ({FormatEscrutadoSlot(faldonState.ElectionSlot)}%)" : "SONDEO") · E@(faldonState.ElectionSlot)
        </span>
        <span class="ws-onair-pill @(cartonState.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
            <span class="ws-tally-dot"></span>
            CARTÓN: @(cartonState.IsOnAir ? cartonState.ActiveScene : "FUERA") · @(cartonState.Oficiales ? $"OFIC. ({FormatEscrutadoSlot(cartonState.ElectionSlot)}%)" : "SONDEO") · E@(cartonState.ElectionSlot)
        </span>
    </div>

    <div class="ws-topbar-cluster">
        <span class="ws-chip ws-chip-accent">
            @GetConnectionLabel(globalSnapshot.ConnectionType) · @globalSnapshot.Target · Av.@globalSnapshot.Avance
        </span>
        <span class="ws-chip @(globalSnapshot.AutoRefreshEnabled ? "ws-chip-live" : "")">
            Auto-Refresh: @(globalSnapshot.AutoRefreshEnabled ? $"ON ({globalSnapshot.AutoRefreshIntervalSeconds}s)" : "OFF")
        </span>
        <WorkspaceQuickNav Current="WorkspaceKind.ControlGeneral" OperatorId="@currentOperatorId" />
    </div>
</header>

<main class="ws-main-container">
    <div class="ws-tabs">
        <button type="button" class="ws-tab-btn @(activeTab == ControlTab.GlobalLive ? "active" : "")" @onclick="() => activeTab = ControlTab.GlobalLive">
            Control Global (En Vivo)
        </button>
        <button type="button" class="ws-tab-btn @(activeTab == ControlTab.TechnicalConfig ? "active" : "")" @onclick="() => activeTab = ControlTab.TechnicalConfig">
            Configuración Técnica
        </button>
        <button type="button" class="ws-tab-btn @(activeTab == ControlTab.Diagnostics ? "active" : "")" @onclick="() => activeTab = ControlTab.Diagnostics">
            Diagnóstico TCP (@entries.Count)
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <div class="ws-banner @(feedbackIsError ? "ws-banner-error" : "ws-banner-success") d-flex justify-content-between align-items-center mb-3" role="alert">
            <span>@feedbackMessage</span>
            <button type="button" class="ws-icon-btn" aria-label="Cerrar mensaje" @onclick="() => feedbackMessage = string.Empty">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }

    @if (activeTab == ControlTab.GlobalLive)
    {
        <div class="row g-3">
            <div class="col-12 col-xl-7">
                <div class="ws-panel h-100">
                    <div class="ws-control-group-title">Parámetros Globales de Emisión</div>
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Conexión BD</label>
                            <select class="form-select form-select-sm" value="@globalSnapshot.ConnectionType" @onchange="OnConnectionTypeChanged">
                                <option value="0">Principal</option>
                                <option value="1">Reserva</option>
                                <option value="2">Local</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Motor Gráfico (Target)</label>
                            <select class="form-select form-select-sm" value="@globalSnapshot.Target" @onchange="OnTargetChanged">
                                <option value="@GraphicsTarget.Ipf">IPF</option>
                                <option value="@GraphicsTarget.Prime">Prime</option>
                                <option value="@GraphicsTarget.Both">Ambos (IPF + Prime)</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Avance Participación</label>
                            <select class="form-select form-select-sm" value="@globalSnapshot.Avance" @onchange="OnAvanceChanged">
                                <option value="0">Sin avance (0)</option>
                                <option value="1">Avance 1</option>
                                <option value="2">Avance 2</option>
                                <option value="3">Avance 3</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label form-label-sm mb-1">Nombre Exportación CSV</label>
                            <input class="form-control form-control-sm" value="@globalSnapshot.ExportName" @onchange="OnExportNameChanged" />
                        </div>
                        <div class="col-12 mt-2">
                            <div class="form-check form-switch">
                                <input id="chkZeroSeats" class="form-check-input" type="checkbox" checked="@globalSnapshot.IncludeZeroSeats" @onchange="OnIncludeZeroSeatsChanged" />
                                <label class="form-check-label small" for="chkZeroSeats">Incluir partidos con 0 escaños en envíos y exportaciones</label>
                            </div>
                        </div>
                    </div>

                    <div class="ws-subcard mt-3">
                        <div class="ws-control-group-title mb-2">Sincronización Puntual a Ambos Módulos (Faldón + Cartón)</div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <div class="ws-inline-field">
                                <label for="sync-slot-select">Elección:</label>
                                <select id="sync-slot-select" class="form-select form-select-sm ws-select-slot" @bind="syncElectionSlot">
                                    <option value="1">Elección 1</option>
                                    <option value="2">Elección 2</option>
                                    <option value="3">Elección 3</option>
                                </select>
                            </div>
                            <div class="ws-seg-group ws-seg-compact" role="group" aria-label="Modo a sincronizar">
                                <button type="button" class="ws-seg-btn @(syncOficiales ? "active" : "")" @onclick="() => syncOficiales = true">
                                    Oficiales
                                </button>
                                <button type="button" class="ws-seg-btn @(!syncOficiales ? "active-amber" : "")" @onclick="() => syncOficiales = false">
                                    Sondeo
                                </button>
                            </div>
                            <button type="button" class="ws-btn ws-btn-primary-outline ms-auto" @onclick="SyncBothModules">
                                Aplicar a Faldón y Cartón
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="ws-panel h-100">
                    <div class="ws-control-group-title">Auto-Refresh de Base de Datos (Servidor)</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input id="chkAutoRefresh" class="form-check-input" type="checkbox" checked="@globalSnapshot.AutoRefreshEnabled" @onchange="OnAutoRefreshEnabledChanged" />
                                <label class="form-check-label small fw-semibold" for="chkAutoRefresh">
                                    @(globalSnapshot.AutoRefreshEnabled ? "Auto-Refresh Activo" : "Auto-Refresh Pausado")
                                </label>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Intervalo (2 - 60 seg)</label>
                            <input type="number" min="2" max="60" class="form-control form-control-sm ws-num" value="@globalSnapshot.AutoRefreshIntervalSeconds" @onchange="OnAutoRefreshIntervalChanged" />
                        </div>
                        <div class="col-12 mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="small text-muted ws-mono">
                                <div><strong>Última comprobación:</strong> @(globalSnapshot.LastAutoRefreshCheckUtc?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</div>
                                <div><strong>Última actualización:</strong> @(globalSnapshot.LastAutoRefreshAppliedUtc?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</div>
                                <div class="font-sans"><strong>Estado:</strong> @(string.IsNullOrWhiteSpace(globalSnapshot.LastAutoRefreshStatus) ? "-" : globalSnapshot.LastAutoRefreshStatus)</div>
                            </div>
                            <button type="button" class="ws-btn ws-btn-primary-outline ws-btn-xs" @onclick="CheckDatabaseChangesNowAsync" disabled="@checkingDbChanges">
                                @(checkingDbChanges ? "Comprobando..." : "Comprobar BD ahora")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            @foreach (var module in SupervisedModules)
            {
                var state = StateService.GetState(module);
                var lockInfo = GetModuleLockInfo(module);
                var moduleLabel = module == GraphicModule.Faldon ? "FALDÓN" : "CARTÓN";
                <div class="col-12 col-md-6">
                    <div class="ws-panel @(state.IsOnAir ? "ws-panel-live" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <span class="ws-control-group-title mb-0">Supervisión @moduleLabel</span>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (state.Oficiales)
                                {
                                    <span class="ws-chip ws-chip-accent ws-mono">
                                        Escrutinio Gral.: <strong>@FormatEscrutadoSlot(state.ElectionSlot)%</strong>
                                    </span>
                                }
                                <span class="ws-onair-pill @(state.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
                                    <span class="ws-tally-dot"></span> @(state.IsOnAir ? "EN AIRE" : "FUERA DE AIRE")
                                </span>
                            </div>
                        </div>

                        <div class="ws-subcard mb-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div class="ws-inline-field">
                                    <label>Elección @moduleLabel:</label>
                                    <select class="form-select form-select-sm ws-select-slot"
                                            value="@state.ElectionSlot"
                                            @onchange="e => OnSupervisedModuleSlotChanged(module, e)">
                                        <option value="1">Elección 1</option>
                                        <option value="2">Elección 2</option>
                                        <option value="3">Elección 3</option>
                                    </select>
                                </div>

                                <div class="ws-seg-group ws-seg-compact" role="group" aria-label="@($"Modo de datos de {moduleLabel}")">
                                    <button type="button"
                                            class="ws-seg-btn @(state.Oficiales ? "active" : "")"
                                            @onclick="() => SetSupervisedModuleOficiales(module, true)">
                                        Oficiales
                                    </button>
                                    <button type="button"
                                            class="ws-seg-btn @(!state.Oficiales ? "active-amber" : "")"
                                            @onclick="() => SetSupervisedModuleOficiales(module, false)">
                                        Sondeo
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="ws-kpi-grid mb-3">
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Escena activa</div>
                                <div class="ws-kpi-value">@(string.IsNullOrWhiteSpace(state.ActiveScene) ? "-" : state.ActiveScene)</div>
                            </div>
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Bloqueo (Lock)</div>
                                <div class="ws-kpi-value">@(lockInfo.IsLocked ? lockInfo.Owner : "Libre")</div>
                            </div>
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Último operador</div>
                                <div class="ws-kpi-value">@(string.IsNullOrWhiteSpace(state.LastOperatorId) ? "-" : state.LastOperatorId)</div>
                            </div>
                            <div class="ws-kpi-item">
                                <div class="ws-kpi-label">Sede / Vídeos</div>
                                <div class="ws-kpi-value">
                                    Sede: @(state.IsSedeExpanding ? "Sí" : "No") · Vídeos: @(state.ExpandedVideos.Count == 0 ? "-" : string.Join(", ", state.ExpandedVideos))
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="ws-btn ws-btn-amber-outline" @onclick="() => ForceUnlockModule(module)" disabled="@(!lockInfo.IsLocked)">
                                Forzar Desbloqueo
                            </button>
                            <button type="button" class="ws-btn ws-btn-danger-outline" @onclick="() => ResetModuleAsync(module)">
                                Reset Módulo
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == ControlTab.TechnicalConfig)
    {
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <div class="ws-panel h-100">
                    <div class="ws-control-group-title">Destinos Gráficos (IPF / PRIME / IPF2)</div>
                    <div class="form-check form-switch mb-2">
                        <input id="sendIpf2WithIpf" class="form-check-input" type="checkbox" @bind="graphics.SendToIpf2WithIpf" />
                        <label for="sendIpf2WithIpf" class="form-check-label small">Duplicar envíos IPF hacia IPF2</label>
                    </div>

                    <div class="ws-subcard mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="small">IPF Principal</strong>
                            <div class="form-check form-switch mb-0">
                                <input id="ipfEnabled" class="form-check-input" type="checkbox" @bind="graphics.Ipf.Enabled" />
                                <label class="form-check-label small" for="ipfEnabled">Activo</label>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label form-label-sm mb-1">Host</label>
                                <input class="form-control form-control-sm" @bind="graphics.Ipf.Host" />
                            </div>
                            <div class="col-3">
                                <label class="form-label form-label-sm mb-1">Puerto</label>
                                <input class="form-control form-control-sm" type="number" min="1" @bind="graphics.Ipf.Port" />
                            </div>
                            <div class="col-3">
                                <label class="form-label form-label-sm mb-1">BD</label>
                                <input class="form-control form-control-sm" @bind="graphics.Ipf.Bd" />
                            </div>
                        </div>
                    </div>

                    <div class="ws-subcard mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="small">PRIME</strong>
                            <div class="form-check form-switch mb-0">
                                <input id="primeEnabled" class="form-check-input" type="checkbox" @bind="graphics.Prime.Enabled" />
                                <label class="form-check-label small" for="primeEnabled">Activo</label>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label form-label-sm mb-1">Host</label>
                                <input class="form-control form-control-sm" @bind="graphics.Prime.Host" />
                            </div>
                            <div class="col-3">
                                <label class="form-label form-label-sm mb-1">Puerto</label>
                                <input class="form-control form-control-sm" type="number" min="1" @bind="graphics.Prime.Port" />
                            </div>
                            <div class="col-3">
                                <label class="form-label form-label-sm mb-1">BD</label>
                                <input class="form-control form-control-sm" @bind="graphics.Prime.Bd" />
                            </div>
                        </div>
                    </div>

                    <div class="ws-subcard mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="small">IPF2 (Secundario)</strong>
                            <div class="form-check form-switch mb-0">
                                <input id="ipf2Enabled" class="form-check-input" type="checkbox" @bind="graphics.Ipf2.Enabled" />
                                <label class="form-check-label small" for="ipf2Enabled">Activo</label>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label form-label-sm mb-1">Host</label>
                                <input class="form-control form-control-sm" @bind="graphics.Ipf2.Host" />
                            </div>
                            <div class="col-3">
                                <label class="form-label form-label-sm mb-1">Puerto</label>
                                <input class="form-control form-control-sm" type="number" min="1" @bind="graphics.Ipf2.Port" />
                            </div>
                            <div class="col-3">
                                <label class="form-label form-label-sm mb-1">BD</label>
                                <input class="form-control form-control-sm" @bind="graphics.Ipf2.Bd" />
                            </div>
                        </div>
                    </div>

                    <div class="ws-subcard mb-2">
                        <strong class="small d-block mb-2">Rutas de Datos CSV / JSON (Aislamiento por Módulo)</strong>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label form-label-sm mb-1">Carpeta CSV General</label>
                                <input class="form-control form-control-sm" @bind="storage.CsvFolder" />
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm mb-1">Carpeta JSON General</label>
                                <input class="form-control form-control-sm" @bind="storage.JsonFolder" />
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm mb-1">CSV específico Faldón (opcional)</label>
                                <input class="form-control form-control-sm" @bind="faldonCsvFolderOverride" placeholder="Vacío = usa carpeta general" />
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm mb-1">CSV específico Cartón (opcional)</label>
                                <input class="form-control form-control-sm" @bind="cartonCsvFolderOverride" placeholder="Vacío = usa carpeta general" />
                            </div>
                        </div>
                    </div>

                    <div class="ws-subcard mb-2">
                        <strong class="small d-block mb-2">Nombres de Archivos CSV de Cartones (Nuevo Grafismo)</strong>
                        <div class="row g-2">
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm mb-1">Participación</label>
                                <input class="form-control form-control-sm ws-mono" @bind="storage.CartonCsvFiles.ParticipacionFileName" />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm mb-1">Mayorías (Partidos)</label>
                                <input class="form-control form-control-sm ws-mono" @bind="storage.CartonCsvFiles.MayoriasPartidosFileName" />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm mb-1">Mayorías (Provincia)</label>
                                <input class="form-control form-control-sm ws-mono" @bind="storage.CartonCsvFiles.MayoriasProvinciaFileName" />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm mb-1">Estatal (Partidos)</label>
                                <input class="form-control form-control-sm ws-mono" @bind="storage.CartonCsvFiles.EstatalPartidosFileName" />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm mb-1">Estatal (Provincia)</label>
                                <input class="form-control form-control-sm ws-mono" @bind="storage.CartonCsvFiles.EstatalProvinciaFileName" />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm mb-1">Cuadraditos</label>
                                <input class="form-control form-control-sm ws-mono" @bind="storage.CartonCsvFiles.CuadraditosFileName" />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm mb-1">Último Escaño</label>
                                <input class="form-control form-control-sm ws-mono" @bind="storage.CartonCsvFiles.UltimoEscanoFileName" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="ws-btn ws-btn-primary" @onclick="SaveConfigAsync" disabled="@saving">
                            @(saving ? "Guardando..." : "Guardar Configuración")
                        </button>
                        <button type="button" class="ws-btn ws-btn-primary-outline" @onclick="CheckConnectivityAsync" disabled="@checkingConnectivity">
                            @(checkingConnectivity ? "Comprobando..." : "Comprobar Conexiones")
                        </button>
                    </div>

                    @if (connectivityStatuses.Count > 0)
                    {
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            @foreach (var status in connectivityStatuses)
                            {
                                <span class="ws-chip @(!status.Enabled ? "" : status.Reachable ? "ws-chip-live" : "ws-chip-danger")">
                                    @status.Name (@status.Host:@status.Port): @status.Message
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="ws-panel h-100">
                    <div class="ws-control-group-title">Horas Operativas</div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 1</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 1 Histórico</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance1Historico" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 2</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance2" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 2 Histórico</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance2Historico" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 3</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Avance 3 Histórico</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraAvance3Historico" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Participación</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraParticipacion" />
                        </div>
                        <div class="col-6">
                            <label class="form-label form-label-sm mb-1">Participación Histórica</label>
                            <input class="form-control form-control-sm" @bind="operational.Hours.HoraParticipacionHistorico" />
                        </div>
                    </div>

                    <div class="ws-control-group-title">Fuentes de Vídeo (Slots 1-6)</div>
                    <table class="ws-table w-100 mb-0">
                        <thead>
                            <tr>
                                <th>Slot</th>
                                <th>Modo</th>
                                <th>Ruta / URL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in operational.VideoSources.OrderBy(x => x.Slot))
                            {
                                <tr>
                                    <td>@source.Slot</td>
                                    <td>
                                        <div class="form-check form-switch mb-0">
                                            <input id="@($"videoLive{source.Slot}")" class="form-check-input" type="checkbox" @bind="source.IsLive" />
                                            <label class="form-check-label small" for="@($"videoLive{source.Slot}")">
                                                @(source.IsLive ? "Directo" : "Pregrabado")
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm" @bind="source.Path" placeholder="Ruta local o URL" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (activeTab == ControlTab.Diagnostics)
    {
        <div class="ws-panel">
            <div class="row g-2 mb-2 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Filtrar por módulo</label>
                    <select class="form-select form-select-sm" @bind="selectedModuleFilter">
                        <option value="">Todos</option>
                        <option value="@GraphicModule.Faldon">Faldón</option>
                        <option value="@GraphicModule.Carton">Cartón</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Filtrar por destino</label>
                    <input class="form-control form-control-sm" placeholder="IPF, Prime..." @bind="targetFilter" />
                </div>
                <div class="col-12 col-md-6 d-flex gap-2">
                    <button type="button" class="ws-btn ws-btn-primary-outline" @onclick="RefreshDiagnostics">Refrescar</button>
                    <button type="button" class="ws-btn ws-btn-danger-outline" @onclick="ClearDiagnostics">Limpiar Consola</button>
                </div>
            </div>

            <div class="ws-diag-scroll">
                <table class="ws-table w-100 mb-0">
                    <thead>
                        <tr>
                            <th>Hora (UTC)</th>
                            <th>Módulo</th>
                            <th>Destino</th>
                            <th>Endpoint</th>
                            <th>Estado</th>
                            <th>Señal TCP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredEntries.Any())
                        {
                            @foreach (var entry in FilteredEntries)
                            {
                                <tr>
                                    <td class="text-nowrap ws-mono">@entry.TimestampUtc.ToString("HH:mm:ss.fff")</td>
                                    <td><span class="ws-chip ws-chip-accent">@(entry.Module?.ToString() ?? "-")</span></td>
                                    <td>@entry.EndpointName</td>
                                    <td class="ws-mono text-muted">@entry.Host:@entry.Port</td>
                                    <td>
                                        <span class="ws-chip @(entry.Delivered ? "ws-chip-live" : "ws-chip-danger")">
                                            @(entry.Delivered ? "OK" : "ERROR")
                                        </span>
                                    </td>
                                    <td>
                                        <code>@entry.Payload</code>
                                        @if (!entry.Delivered && !string.IsNullOrWhiteSpace(entry.StatusMessage))
                                        {
                                            <div class="ws-status-msg-error mt-1">@entry.StatusMessage</div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hay entradas de diagnóstico para el filtro actual.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</main>

@code {
    private enum ControlTab
    {
        GlobalLive,
        TechnicalConfig,
        Diagnostics
    }

    private static readonly GraphicModule[] SupervisedModules = [GraphicModule.Faldon, GraphicModule.Carton];
    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-ES");
    private readonly Dictionary<int, double> escrutadoBySlot = new();

    private ControlTab activeTab = ControlTab.GlobalLive;
    private GlobalOperationalSettings globalSnapshot = new();
    private GraphicsEndpointsOptions graphics = new();
    private OperationalOptions operational = new();
    private StorageOptions storage = new();
    private string faldonCsvFolderOverride = string.Empty;
    private string cartonCsvFolderOverride = string.Empty;
    private ModuleOperationalState faldonState = new() { Module = GraphicModule.Faldon };
    private ModuleOperationalState cartonState = new() { Module = GraphicModule.Carton };
    private IReadOnlyList<ModuleLockInfo> lockStates = [];
    private IReadOnlyList<SignalDiagnosticEntry> entries = [];
    private IReadOnlyList<EndpointConnectivityStatus> connectivityStatuses = [];

    private int syncElectionSlot = 1;
    private bool syncOficiales;

    private string currentOperatorId = "op_admin";
    private string feedbackMessage = string.Empty;
    private bool feedbackIsError;
    private bool saving;
    private bool checkingConnectivity;
    private bool checkingDbChanges;
    private string selectedModuleFilter = string.Empty;
    private string targetFilter = string.Empty;

    private IEnumerable<SignalDiagnosticEntry> FilteredEntries => entries
        .Where(e => string.IsNullOrWhiteSpace(selectedModuleFilter) || string.Equals(e.Module?.ToString(), selectedModuleFilter, StringComparison.OrdinalIgnoreCase))
        .Where(e => string.IsNullOrWhiteSpace(targetFilter) || e.EndpointName.Contains(targetFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(userName))
        {
            currentOperatorId = userName;
        }

        globalSnapshot = GlobalSettings.GetSettings();
        LoadTechnicalConfig();
        RefreshStatesAndDiagnostics();
        await RefreshEscrutadoBySlotAsync();
        syncElectionSlot = faldonState.ElectionSlot;
        syncOficiales = faldonState.Oficiales;

        GlobalSettings.OnSettingsChanged += HandleGlobalSettingsChanged;
        StateService.OnStateChanged += HandleModuleStateChanged;
        ModuleLockService.LocksChanged += HandleLocksChanged;
        DiagnosticsService.EntriesChanged += HandleDiagnosticsChanged;
    }

    private void LoadTechnicalConfig()
    {
        var snapshot = ConfigService.GetSnapshot();
        graphics = snapshot.GraphicsEndpoints;
        operational = snapshot.Operational;
        storage = snapshot.Storage;
        faldonCsvFolderOverride = storage.ResolveCsvFolderOverride("Faldon");
        cartonCsvFolderOverride = storage.ResolveCsvFolderOverride("Carton");
    }

    private void RefreshStatesAndDiagnostics()
    {
        faldonState = StateService.GetState(GraphicModule.Faldon);
        cartonState = StateService.GetState(GraphicModule.Carton);
        lockStates = ModuleLockService.GetStates();
        entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
    }

    private async Task RefreshEscrutadoBySlotAsync()
    {
        foreach (var slot in new[] { 1, 2, 3 })
        {
            try
            {
                var snap = await DataService.GetSnapshotAsync(new SnapshotQuery
                {
                    ElectionSlot = slot,
                    ConnectionType = globalSnapshot.ConnectionType,
                    Kind = SnapshotQueryKind.Circunscripcion,
                    CircunscripcionCodigo = "9900000"
                }, oficiales: true);

                escrutadoBySlot[slot] = snap.EscrutadoGeneral > 0 ? snap.EscrutadoGeneral : snap.Escrutado;
            }
            catch
            {
                escrutadoBySlot[slot] = 0;
            }
        }
    }

    private string FormatEscrutadoSlot(int slot)
        => escrutadoBySlot.TryGetValue(slot, out var val) ? val.ToString("0.00", EsCulture) : "0,00";

    private ModuleLockInfo GetModuleLockInfo(GraphicModule module) =>
        lockStates.FirstOrDefault(x => x.Module == module) ?? new ModuleLockInfo { Module = module };

    private static string GetConnectionLabel(int connectionType) => connectionType switch
    {
        0 => "BD Principal",
        1 => "BD Reserva",
        2 => "BD Local",
        _ => $"Conn {connectionType}"
    };

    private async Task OnConnectionTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var conn))
        {
            GlobalSettings.UpdateSettings(s => s with { ConnectionType = conn });
            await RefreshEscrutadoBySlotAsync();
        }
    }

    private void OnTargetChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<GraphicsTarget>(e.Value?.ToString(), out var target))
        {
            GlobalSettings.UpdateSettings(s => s with { Target = target });
        }
    }

    private void OnAvanceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var avance))
        {
            GlobalSettings.UpdateSettings(s => s with { Avance = avance });
        }
    }

    private void OnExportNameChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(name))
        {
            GlobalSettings.UpdateSettings(s => s with { ExportName = name.Trim() });
        }
    }

    private void OnIncludeZeroSeatsChanged(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        GlobalSettings.UpdateSettings(s => s with { IncludeZeroSeats = enabled });
    }

    private void SyncBothModules()
    {
        StateService.SyncAllModules(syncElectionSlot, syncOficiales);
        GlobalSettings.UpdateSettings(s => s with
        {
            ElectionSlot = syncElectionSlot,
            Oficiales = syncOficiales
        });
        RefreshStatesAndDiagnostics();
        feedbackMessage = $"Faldón y Cartón sincronizados a Elección {syncElectionSlot} · {(syncOficiales ? "Oficiales" : "Sondeo")}.";
        feedbackIsError = false;
    }

    private void OnSupervisedModuleSlotChanged(GraphicModule module, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var slot))
        {
            return;
        }

        var current = StateService.GetState(module);
        StateService.ConfigureModule(module, slot, current.Oficiales);
        RefreshStatesAndDiagnostics();
    }

    private void SetSupervisedModuleOficiales(GraphicModule module, bool oficiales)
    {
        var current = StateService.GetState(module);
        StateService.ConfigureModule(module, current.ElectionSlot, oficiales);
        RefreshStatesAndDiagnostics();
    }

    private void OnAutoRefreshEnabledChanged(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        GlobalSettings.UpdateSettings(s => s with { AutoRefreshEnabled = enabled });
    }

    private void OnAutoRefreshIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var interval))
        {
            GlobalSettings.UpdateSettings(s => s with { AutoRefreshIntervalSeconds = Math.Clamp(interval, 2, 60) });
        }
    }

    private async Task CheckDatabaseChangesNowAsync()
    {
        checkingDbChanges = true;
        try
        {
            var count = await ChangeListenerService.CheckAndDispatchUpdatesOnceAsync();
            globalSnapshot = GlobalSettings.GetSettings();
            await RefreshEscrutadoBySlotAsync();
            feedbackMessage = count > 0
                ? $"Actualización automática disparada ({count} señal(es))."
                : globalSnapshot.LastAutoRefreshStatus;
            feedbackIsError = false;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al comprobar BD: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            checkingDbChanges = false;
        }
    }

    private void ForceUnlockModule(GraphicModule module)
    {
        ModuleLockService.ForceRelease(module);
        feedbackMessage = $"Bloqueo de {module} liberado por administración.";
        feedbackIsError = false;
        RefreshStatesAndDiagnostics();
    }

    private async Task ResetModuleAsync(GraphicModule module)
    {
        ModuleLockService.ForceRelease(module);
        ModuleLockService.TryAcquire(module, currentOperatorId);
        try
        {
            var activeState = StateService.GetState(module);
            var query = activeState.ActiveQuery ?? new SnapshotQuery
            {
                ElectionSlot = activeState.ElectionSlot,
                ConnectionType = globalSnapshot.ConnectionType,
                Kind = SnapshotQueryKind.Circunscripcion,
                CircunscripcionCodigo = "9900000",
                Avance = globalSnapshot.Avance,
                IncludeZeroSeats = globalSnapshot.IncludeZeroSeats
            };

            var result = await OperationService.ExecuteAsync(new OperationRequest
            {
                OperatorId = currentOperatorId,
                Module = module,
                Action = OperationActionType.Reset,
                Command = GraphicCommand.None,
                Scene = string.IsNullOrWhiteSpace(activeState.ActiveScene) ? "ESCRUTINIO" : activeState.ActiveScene,
                Oficiales = activeState.Oficiales,
                Target = globalSnapshot.Target,
                Query = query,
                ExportName = globalSnapshot.ExportName
            });

            feedbackMessage = result.Message;
            feedbackIsError = !result.Success;
        }
        finally
        {
            ModuleLockService.Release(module, currentOperatorId);
            RefreshStatesAndDiagnostics();
        }
    }

    private async Task SaveConfigAsync()
    {
        saving = true;
        feedbackMessage = string.Empty;
        feedbackIsError = false;
        try
        {
            storage.CsvFoldersByModule["Faldon"] = faldonCsvFolderOverride?.Trim() ?? string.Empty;
            storage.CsvFoldersByModule["Carton"] = cartonCsvFolderOverride?.Trim() ?? string.Empty;

            var result = await ConfigService.SaveAsync(new OperationalConfigurationSnapshot
            {
                GraphicsEndpoints = graphics,
                Operational = operational,
                Storage = storage
            });

            feedbackMessage = result.Message;
            feedbackIsError = !result.Success;
            LoadTechnicalConfig();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CheckConnectivityAsync()
    {
        checkingConnectivity = true;
        feedbackMessage = string.Empty;
        feedbackIsError = false;
        try
        {
            connectivityStatuses = await ConfigService.CheckConnectivityAsync();
            feedbackMessage = "Comprobación de conectividad completada.";
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error comprobando conexiones: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            checkingConnectivity = false;
        }
    }

    private void RefreshDiagnostics()
    {
        entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
    }

    private void ClearDiagnostics()
    {
        DiagnosticsService.Clear();
        RefreshDiagnostics();
    }

    private void HandleGlobalSettingsChanged(GlobalOperationalSettings settings)
    {
        _ = InvokeAsync(() =>
        {
            globalSnapshot = settings;
            StateHasChanged();
        });
    }

    private void HandleModuleStateChanged(GraphicModule module, ModuleOperationalState state)
    {
        _ = InvokeAsync(() =>
        {
            RefreshStatesAndDiagnostics();
            StateHasChanged();
        });
    }

    private void HandleLocksChanged()
    {
        _ = InvokeAsync(() =>
        {
            lockStates = ModuleLockService.GetStates();
            StateHasChanged();
        });
    }

    private void HandleDiagnosticsChanged()
    {
        _ = InvokeAsync(() =>
        {
            entries = DiagnosticsService.GetRecentEntries(maxCount: 100);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        GlobalSettings.OnSettingsChanged -= HandleGlobalSettingsChanged;
        StateService.OnStateChanged -= HandleModuleStateChanged;
        ModuleLockService.LocksChanged -= HandleLocksChanged;
        DiagnosticsService.EntriesChanged -= HandleDiagnosticsChanged;
    }
}
