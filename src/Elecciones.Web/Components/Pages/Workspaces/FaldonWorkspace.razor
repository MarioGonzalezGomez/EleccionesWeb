@page "/faldon"
@page "/operacion/faldon"
@page "/operacion/botonera"
@page "/operacion/pactos"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using Elecciones.Application.Abstractions
@using Elecciones.Application.Models
@using Elecciones.Application.Services
@using Elecciones.GraphicsGateway.Options
@using Elecciones.Infrastructure.Options
@using EleccionesWeb.Services
@using Microsoft.Extensions.Options
@inject IModuleLockService ModuleLockService
@inject IOperationService OperationService
@inject IEleccionesDataService DataService
@inject IOperatorAuthorizationService AuthorizationService
@inject ConfiguredOperatorAuthorizationService AuthConfig
@inject IGlobalOperationalSettingsService GlobalSettingsService
@inject IOperationStateService StateService
@inject IOperationalConfigurationService ConfigService
@inject IOptionsMonitor<GraphicsEndpointsOptions> GraphicsMonitor
@inject IOptionsMonitor<DatabaseOptions> DatabaseMonitor
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Faldón</PageTitle>

<header class="ws-topbar">
    <div class="ws-topbar-cluster">
        <span class="ws-brand-mark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 18v2h16v-2" />
                <rect x="4" y="4" width="16" height="10" rx="2" />
            </svg>
            Faldón
        </span>
        <span class="ws-onair-pill @(moduleState.IsOnAir ? "ws-onair-active" : "ws-onair-idle")">
            <span class="ws-tally-dot"></span>
            @(moduleState.IsOnAir ? $"EN AIRE: {(string.IsNullOrWhiteSpace(moduleState.ActiveScene) ? ActiveSceneName : moduleState.ActiveScene)}" : "FUERA DE AIRE")
        </span>
        @{
            var faldonIpf = GraphicsMonitor.CurrentValue.ResolveIpfForModule(GraphicModule.Faldon);
        }
        <span class="ws-chip @(faldonIpf.Enabled ? string.Empty : "ws-chip-danger") ws-mono"
              title="Destino Brainstorm asignado al módulo de Faldón">
            Brainstorm: <strong>@(faldonIpf.Enabled ? $"{faldonIpf.Host}:{faldonIpf.Port} ({faldonIpf.Bd})" : "OFF")</strong>
        </span>
        @if (moduleOficiales && EffectiveEscrutadoGeneral.HasValue)
        {
            <span class="ws-chip ws-chip-accent ws-mono">
                Escrutinio Gral.: <strong>@EffectiveEscrutadoGeneral.Value.ToString("0.00", EsCulture)%</strong>
            </span>
        }
        @if (!IsOwner)
        {
            <button class="ws-btn ws-btn-amber ws-btn-xs" type="button" @onclick="ClaimModuleLock">
                Tomar control
            </button>
        }
    </div>

    <div class="ws-topbar-cluster">
        <div class="ws-seg-group ws-seg-compact" role="group" aria-label="Modo de datos de Faldón">
            <button type="button"
                    class="ws-seg-btn @(moduleOficiales ? "active" : string.Empty)"
                    @onclick="() => SetModuleOficialesAsync(true)">
                Oficiales
            </button>
            <button type="button"
                    class="ws-seg-btn @(!moduleOficiales ? "active-amber" : string.Empty)"
                    @onclick="() => SetModuleOficialesAsync(false)">
                Sondeo
            </button>
        </div>

        <div class="ws-inline-field">
            <label for="faldon-slot-select">Elección:</label>
            <select id="faldon-slot-select"
                    class="form-select form-select-sm ws-select-slot"
                    value="@moduleElectionSlot"
                    disabled="@(ActiveElections.Count <= 1)"
                    @onchange="OnModuleElectionSlotChangedAsync">
                @foreach (var elec in ActiveElections)
                {
                    <option @key="elec.Slot" value="@elec.Slot">@elec.Label</option>
                }
            </select>
        </div>

        <div class="ws-inline-field">
            <label for="faldon-circ-select">Circunscripción:</label>
            <CircunscripcionTreeSelector Id="faldon-circ-select"
                                         Items="@circunscripciones"
                                         Value="@selectedCircunscripcionCodigo"
                                         ValueChanged="OnCircunscripcionSelectedAsync" />
        </div>

        @if (!moduleOficiales)
        {
            <div class="ws-inline-field">
                <label for="faldon-medio-select">Sondeo:</label>
                <select id="faldon-medio-select"
                        class="form-select form-select-sm ws-select-medio"
                        value="@selectedMedioCodigo"
                        @onchange="OnMedioChangedAsync">
                    @foreach (var medio in medios)
                    {
                        <option @key="@($"{moduleElectionSlot}_{medio.Codigo}")" value="@medio.Codigo">@medio.Descripcion</option>
                    }
                </select>
                <button type="button"
                        class="ws-btn ws-btn-primary-outline ws-btn-xs"
                        title="Actualizar la lista de medios desde la base de datos"
                        @onclick="ReloadReferenceDataAsync">
                    Actualizar
                </button>
            </div>
        }

        <div class="ws-inline-field">
            <label for="faldon-lang-select">Idioma:</label>
            <select id="faldon-lang-select"
                    class="form-select form-select-sm ws-select-lang"
                    value="@moduleLanguage"
                    disabled="@(!CanExecute)"
                    title="Envía el evento de idioma al Brainstorm de Faldón sin alterar la interfaz web"
                    @onchange="OnGraphicLanguageChangedAsync">
                @foreach (var lang in Enum.GetValues<GraphicLanguage>())
                {
                    <option value="@lang">@lang.ToDisplayName()</option>
                }
            </select>
        </div>

        <WorkspaceQuickNav Current="WorkspaceKind.Faldon" OperatorId="@operatorId" />
    </div>
</header>

<div class="ws-body">
    <section class="ws-panel @(moduleState.IsOnAir ? "ws-panel-live" : string.Empty)">
        @if (!string.IsNullOrWhiteSpace(feedbackMessage))
        {
            <div class="ws-banner @(feedbackIsError ? "ws-banner-error" : "ws-banner-success") mb-3" role="status">
                <div class="d-flex align-items-center gap-2">
                    @if (feedbackIsError)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    }
                    <span>@feedbackMessage</span>
                </div>
                <button type="button" class="ws-icon-btn" aria-label="Cerrar mensaje" @onclick="() => feedbackMessage = string.Empty">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 ws-tabs-header-row">
            <div class="ws-tabs mb-0">
                @foreach (var mode in VisibleModes)
                {
                    <button type="button"
                            class="ws-tab-btn @(activeMode == mode ? "active" : null)"
                            @onclick="() => SelectMode(mode)">
                        @GetModeLabel(mode)
                    </button>
                }
            </div>
        </div>

        <SceneActionBar SceneLabel="@ActiveSceneName"
                        Oficiales="@moduleOficiales"
                        EscrutadoGeneral="@EffectiveEscrutadoGeneral"
                        EscrutadoCircunscripcion="@currentSnapshot?.Escrutado"
                        IsSubCircunscripcion="@IsSubCircunscripcion"
                        Disabled="@(!CanExecute)"
                        OnAction="RunSceneActionAsync" />

        @switch (activeMode)
        {
            case FaldonMode.General:
                <div class="row g-3">
                    <div class="col-12 col-lg-8">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Transiciones y Animación</div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button type="button"
                                        class="ws-toggle-btn @(moduleState.PrimerosResultadosEnabled ? "is-on" : "is-off")"
                                        aria-pressed="@moduleState.PrimerosResultadosEnabled"
                                        disabled="@(!CanExecute)"
                                        @onclick="TogglePrimerosResultadosAsync">
                                    <span class="ws-toggle-track" aria-hidden="true"><span class="ws-toggle-thumb"></span></span>
                                    <span>Primeros Resultados</span>
                                    <span class="ws-toggle-state">@(moduleState.PrimerosResultadosEnabled ? "ON" : "OFF")</span>
                                </button>

                                <button type="button"
                                        class="ws-toggle-btn @(moduleState.AnimacionSondeoEnabled ? "is-on" : "is-off")"
                                        aria-pressed="@moduleState.AnimacionSondeoEnabled"
                                        disabled="@(!CanExecute)"
                                        @onclick="ToggleAnimacionSondeoAsync">
                                    <span class="ws-toggle-track" aria-hidden="true"><span class="ws-toggle-thumb"></span></span>
                                    <span>Animación Sondeo</span>
                                    <span class="ws-toggle-state">@(moduleState.AnimacionSondeoEnabled ? "ON" : "OFF")</span>
                                </button>

                                <button type="button"
                                        class="ws-btn ws-btn-amber"
                                        @onclick="TransitionSondeoToOficialesAsync"
                                        disabled="@(!CanExecute)">
                                    De Sondeo a Oficiales
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Ámbito de Elecciones</div>
                            <div class="ws-seg-group w-100" role="group" aria-label="Ámbito Nacional o Europa">
                                <button type="button"
                                        class="ws-seg-btn @(!moduleState.AmbitoEuropaEnabled ? "active" : string.Empty)"
                                        disabled="@(!CanExecute)"
                                        @onclick="() => SetAmbitoEuropaAsync(false)">
                                    Nacional
                                </button>
                                <button type="button"
                                        class="ws-seg-btn @(moduleState.AmbitoEuropaEnabled ? "active" : string.Empty)"
                                        disabled="@(!CanExecute)"
                                        @onclick="() => SetAmbitoEuropaAsync(true)">
                                    Europa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case FaldonMode.Ticker:
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Ticker Votos</div>
                            <div class="d-flex gap-2">
                                <button class="ws-btn ws-btn-live flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerVotosEntra)" disabled="@(!CanExecute)">Entra</button>
                                <button class="ws-btn ws-btn-amber flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerVotosSale)" disabled="@(!CanExecute)">Sale</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Ticker Históricos</div>
                            <div class="d-flex gap-2">
                                <button class="ws-btn ws-btn-live flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerHistoricosEntra)" disabled="@(!CanExecute)">Entra</button>
                                <button class="ws-btn ws-btn-amber flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerHistoricosSale)" disabled="@(!CanExecute)">Sale</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Ticker Fotos</div>
                            <div class="d-flex gap-2">
                                <button class="ws-btn ws-btn-live flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerFotosEntra)" disabled="@(!CanExecute)">Entra</button>
                                <button class="ws-btn ws-btn-amber flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerFotosSale)" disabled="@(!CanExecute)">Sale</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Ticker TD</div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="ws-btn ws-btn-live flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerTDEntra)" disabled="@(!CanExecute)">Entra</button>
                                <button class="ws-btn ws-btn-primary flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerTDActualiza)" disabled="@(!CanExecute)">Actualiza</button>
                                <button class="ws-btn ws-btn-amber flex-fill" type="button" @onclick="() => RunCommandAsync(GraphicCommand.TickerTDSale)" disabled="@(!CanExecute)">Sale</button>
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case FaldonMode.Sedes:
                <div class="ws-subcard d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <div class="ws-control-group-title">Partido en Sede (selección en tabla inferior o doble clic)</div>
                        <div class="fw-semibold">
                            @if (SelectedParty is not null)
                            {
                                <span class="ws-party-pill">@SelectedParty.Siglas <span>(@SelectedParty.Codigo)</span></span>
                            }
                            else
                            {
                                <span class="text-muted">Selecciona un partido en la tabla inferior</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="ws-btn ws-btn-live"
                                type="button"
                                @onclick="() => RunPartyCommandAsync(GraphicCommand.SedesEntra)"
                                disabled="@(!CanExecute || SelectedParty is null)">
                            Sedes Entra
                        </button>
                        <button class="ws-btn ws-btn-primary"
                                type="button"
                                @onclick="() => RunPartyCommandAsync(GraphicCommand.SedesEncadena)"
                                disabled="@(!CanExecute || SelectedParty is null)">
                            Sedes Encadena
                        </button>
                        <button class="ws-btn ws-btn-amber"
                                type="button"
                                @onclick="() => RunCommandAsync(GraphicCommand.SedesSale)"
                                disabled="@(!CanExecute)">
                            Sedes Sale
                        </button>
                    </div>
                </div>
                break;

            case FaldonMode.VideoPrime:
                <div class="row g-3">
                    <div class="col-12 col-md-7">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Control de Vídeo</div>
                            <div class="row g-2 align-items-center mb-3">
                                <div class="col-auto">
                                    <select class="form-select form-select-sm" @bind="videoSelectionMode">
                                        <option value="party">Por partido (tabla inferior)</option>
                                        <option value="slot">Por fuente de vídeo (Slots 1-6)</option>
                                    </select>
                                </div>
                                @if (videoSelectionMode == "slot")
                                {
                                    <div class="col">
                                        <select class="form-select form-select-sm" @bind="selectedVideoSlot">
                                            @foreach (var source in videoSources.OrderBy(x => x.Slot))
                                            {
                                                var modeLabel = source.IsLive ? "Directo" : "Pregrabado";
                                                var pathLabel = string.IsNullOrWhiteSpace(source.Path) ? "(sin ruta)" : source.Path;
                                                <option value="@source.Slot">@($"Slot {source.Slot} - {modeLabel} - {pathLabel}")</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <div class="col small text-muted">
                                        Partido activo: <strong>@(SelectedParty?.Siglas ?? "Ninguno")</strong>
                                    </div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="ws-btn ws-btn-live" type="button" @onclick="() => ExecuteVideoCommandAsync(GraphicCommand.VideoIn)" disabled="@(!CanExecute || !HasVideoTarget)">Video In</button>
                                <button class="ws-btn ws-btn-amber" type="button" @onclick="() => ExecuteVideoCommandAsync(GraphicCommand.VideoOut)" disabled="@(!CanExecute || !HasVideoTarget)">Video Out</button>
                                <button class="ws-btn ws-btn-live-outline" type="button" @onclick="() => ExecuteVideoCommandAsync(GraphicCommand.VideoInTodos)" disabled="@(!CanExecute)">In Todos</button>
                                <button class="ws-btn ws-btn-amber-outline" type="button" @onclick="() => ExecuteVideoCommandAsync(GraphicCommand.VideoOutTodos)" disabled="@(!CanExecute)">Out Todos</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-5">
                        <div class="ws-subcard h-100">
                            <div class="ws-control-group-title">Rótulos Prime</div>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="ws-btn ws-btn-live" type="button" @onclick="() => RunCommandAsync(GraphicCommand.PrimeSubirRotulosTD)" disabled="@(!CanExecute)">Subir TD</button>
                                <button class="ws-btn ws-btn-amber" type="button" @onclick="() => RunCommandAsync(GraphicCommand.PrimeBajarRotulosTD)" disabled="@(!CanExecute)">Bajar TD</button>
                                <button class="ws-btn ws-btn-live-outline" type="button" @onclick="() => RunCommandAsync(GraphicCommand.PrimeSubirRotulosEspeciales)" disabled="@(!CanExecute)">Subir Especiales</button>
                                <button class="ws-btn ws-btn-amber-outline" type="button" @onclick="() => RunCommandAsync(GraphicCommand.PrimeBajarRotulosEspeciales)" disabled="@(!CanExecute)">Bajar Especiales</button>
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case FaldonMode.Pactometro:
                <div class="ws-subcard mb-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <div class="ws-control-group-title mb-1">Preparar ambos bloques</div>
                            <span class="text-muted small">Selecciona de forma independiente los partidos de cada lado en la tabla inferior.</span>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="ws-btn ws-btn-live-outline" type="button" @onclick="() => ApplyPactometerPartiesAsync(true)" disabled="@(!CanExecute || selectedLeftPactPartyCodes.Count == 0)">
                                Aplicar Izquierda (@selectedLeftPactPartyCodes.Count)
                            </button>
                            <button class="ws-btn ws-btn-primary-outline" type="button" @onclick="() => ApplyPactometerPartiesAsync(false)" disabled="@(!CanExecute || selectedRightPactPartyCodes.Count == 0)">
                                Aplicar Derecha (@selectedRightPactPartyCodes.Count)
                            </button>
                            <button class="ws-btn ws-btn-live" type="button" @onclick="ApplyBothPactometerPartiesAsync" disabled="@(!CanExecute || selectedLeftPactPartyCodes.Count == 0 || selectedRightPactPartyCodes.Count == 0)">
                                Lanzar ambos (@selectedLeftPactPartyCodes.Count · @selectedRightPactPartyCodes.Count)
                            </button>
                            <button class="ws-btn ws-btn-amber-outline" type="button" @onclick="ClearLeftAsync" disabled="@(!CanExecute)">Sale Izquierda</button>
                            <button class="ws-btn ws-btn-amber-outline" type="button" @onclick="ClearRightAsync" disabled="@(!CanExecute)">Sale Derecha</button>
                            <button class="ws-btn" type="button" @onclick="ResetPactosAsync" disabled="@(!CanExecute)">Vaciar composición</button>
                        </div>
                    </div>
                </div>

                <div class="ws-pact-bar" role="img" aria-label="Proporción de escaños izquierda y derecha">
                    <div class="ws-pact-fill-left" style="width: @LeftPactPctCss;"></div>
                    <div class="ws-pact-fill-right" style="width: @RightPactPctCss;"></div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="ws-subcard h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="ws-control-group-title mb-0">Bloque Izquierda</span>
                                <span class="ws-chip ws-chip-live ws-num">@LeftPactEscanos esc</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (leftParties.Count == 0)
                                {
                                    <span class="text-muted small">Sin partidos</span>
                                }
                                else
                                {
                                    @foreach (var p in leftParties)
                                    {
                                        <span class="ws-party-pill">@p.Siglas <span class="ws-num">(@GetDisplayEscanos(p))</span></span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="ws-subcard h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="ws-control-group-title mb-0">Bloque Derecha</span>
                                <span class="ws-chip ws-chip-accent ws-num">@RightPactEscanos esc</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (rightParties.Count == 0)
                                {
                                    <span class="text-muted small">Sin partidos</span>
                                }
                                else
                                {
                                    @foreach (var p in rightParties)
                                    {
                                        <span class="ws-party-pill">@p.Siglas <span class="ws-num">(@GetDisplayEscanos(p))</span></span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case FaldonMode.UltimoEscano:
                <div class="ws-banner ws-banner-warning mb-3" role="status">
                    Último escaño está disponible únicamente con datos Oficiales. Las acciones de entrada y actualización no se enviarán en modo Sondeo.
                </div>
                <div class="ws-subcard">
                    <div class="ws-control-group-title">Datos del último escaño</div>
                    @if (UltimoGanador is null || UltimoSegundo is null)
                    {
                        <span class="text-muted">No hay información de último escaño disponible para esta circunscripción.</span>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="ws-chip ws-chip-amber">Ganador: <strong>@UltimoGanador.Siglas</strong></span>
                            <span class="ws-chip ws-chip-accent">Segundo: <strong>@UltimoSegundo.Siglas</strong></span>
                            <span class="ws-chip">Votos necesarios: <strong>@UltimoSegundo.RestoVotos</strong></span>
                            <span class="ws-chip">Pendientes: <strong>@(currentSnapshot?.VotantesFaltan ?? 0)</strong></span>
                            <span class="ws-chip">Provincia: <strong>@currentSnapshot?.Circunscripcion.Nombre</strong></span>
                        </div>
                    }
                </div>
                break;

            case FaldonMode.CuentaAtras:
                <div class="ws-subcard d-flex align-items-center gap-3">
                    <label for="faldon-countdown-input" class="form-label mb-0 fw-semibold">Segundos de cuenta atrás:</label>
                    <input id="faldon-countdown-input" class="form-control form-control-sm ws-num" style="max-width: 120px;" type="number" min="0" @bind="sceneSeconds" />
                </div>
                break;
        }
    </section>

    <PartySidebarTable Parties="@DisplayedParties"
                       Snapshot="@currentSnapshot"
                       SelectedPartyCode="@selectedPartyCode"
                       Oficiales="@moduleOficiales"
                       ShowUltimoIndicators="@(activeMode == FaldonMode.UltimoEscano)"
                       PactometerSelectionEnabled="@(activeMode == FaldonMode.Pactometro)"
                       LeftSelectedPartyCodes="@selectedLeftPactPartyCodes"
                       RightSelectedPartyCodes="@selectedRightPactPartyCodes"
                       Loading="@loadingParties"
                       OnPartySelected="OnPartySelected"
                       OnPartyDoubleClicked="OnPartyDoubleClickedAsync"
                       OnLeftPartySelectionChanged="ToggleLeftPactPartySelection"
                       OnRightPartySelectionChanged="ToggleRightPactPartySelection"
                       OnRefreshClicked="LoadPartiesAsync" />
</div>

@code {
    private enum FaldonMode
    {
        General,
        Ticker,
        Sedes,
        VideoPrime,
        Pactometro,
        UltimoEscano,
        CuentaAtras
    }

    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-ES");
    private static readonly FaldonMode[] VisibleModes = [FaldonMode.Pactometro, FaldonMode.UltimoEscano];
    private FaldonMode activeMode = FaldonMode.Pactometro;
    private string operatorId = WorkspaceResolver.DefaultFaldonOperator;
    private GlobalOperationalSettings globalSettings = new();
    private ModuleOperationalState moduleState = new() { Module = GraphicModule.Faldon };
    private int moduleElectionSlot = 1;
    private bool moduleOficiales;
    private GraphicLanguage moduleLanguage = GraphicLanguage.Castellano;

    private IReadOnlyList<CircunscripcionSummary> circunscripciones = [];
    private IReadOnlyList<MedioSummary> medios = [new("RTVE", "RTVE")];
    private IReadOnlyList<PartidoSnapshot> availableParties = [];
    private BrainStormSnapshot? currentSnapshot;
    private IReadOnlyList<VideoSourceOptions> videoSources = [];
    private readonly List<PartidoSnapshot> leftParties = [];
    private readonly List<PartidoSnapshot> rightParties = [];
    private readonly List<string> selectedLeftPactPartyCodes = [];
    private readonly List<string> selectedRightPactPartyCodes = [];

    private string selectedCircunscripcionCodigo = string.Empty;
    private string selectedMedioCodigo = "RTVE";
    private string selectedPartyCode = string.Empty;
    private string videoSelectionMode = "party";
    private int selectedVideoSlot = 1;
    private int sceneSeconds = 60;
    private bool loadingParties;
    private string feedbackMessage = string.Empty;
    private bool feedbackIsError;
    private IDisposable? dbOptionsSubscription;

    private IReadOnlyList<ActiveElectionDescriptor> ActiveElections =>
        DatabaseMonitor.CurrentValue.GetActiveElections();

    private string ActiveSceneName => activeMode switch
    {
        FaldonMode.General => moduleOficiales ? "Escrutinio" : "Sondeo",
        FaldonMode.Ticker => "TICKER",
        FaldonMode.Sedes => "SEDES",
        FaldonMode.VideoPrime => "TICKER",
        FaldonMode.Pactometro => "Pactometro",
        FaldonMode.UltimoEscano => "SUPERFALDON_ULTIMOESCANO",
        FaldonMode.CuentaAtras => "CuentaAtras",
        _ => "Escrutinio"
    };

    private PartidoSnapshot? SelectedParty => DisplayedParties.FirstOrDefault(p =>
        string.Equals(p.Codigo, selectedPartyCode, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<PartidoSnapshot> FullCircunscripcionParties =>
        currentSnapshot?.PartidosCircunscripcionCompletos is { Count: > 0 } full
            ? full
            : availableParties;

    private PartidoSnapshot? UltimoGanador => FullCircunscripcionParties.FirstOrDefault(p => p.EsUltimoEscano != 0);
    private PartidoSnapshot? UltimoSegundo => FullCircunscripcionParties.FirstOrDefault(p => p.LuchaUltimoEscano != 0);

    private IReadOnlyList<PartidoSnapshot> DisplayedParties => activeMode == FaldonMode.UltimoEscano
        ? availableParties
            .Concat(FullCircunscripcionParties.Where(p => p.EsUltimoEscano != 0 || p.LuchaUltimoEscano != 0))
            .DistinctBy(p => p.Codigo, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(p => p.EsUltimoEscano)
            .ThenByDescending(p => p.LuchaUltimoEscano)
            .ThenByDescending(GetDisplayEscanos)
            .ThenByDescending(p => p.PorcentajeVoto)
            .ThenByDescending(p => p.Votos)
            .ToList()
        : availableParties;

    private double? EffectiveEscrutadoGeneral => currentSnapshot is null
        ? null
        : (currentSnapshot.EscrutadoGeneral > 0 ? currentSnapshot.EscrutadoGeneral : currentSnapshot.Escrutado);

    private bool IsSubCircunscripcion => !string.IsNullOrWhiteSpace(selectedCircunscripcionCodigo)
        && !string.Equals(selectedCircunscripcionCodigo, "9900000", StringComparison.Ordinal);

    private bool CanOperate => AuthorizationService.CanOperate(operatorId, GraphicModule.Faldon);
    private bool IsOwner => ModuleLockService.IsOwner(GraphicModule.Faldon, operatorId);
    private bool CanExecute => CanOperate && IsOwner;
    private bool HasVideoTarget => videoSelectionMode == "slot" ? selectedVideoSlot is >= 1 and <= 6 : SelectedParty is not null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        operatorId = WorkspaceResolver.ResolveEffectiveOperatorId(
            WorkspaceKind.Faldon,
            authState.User.Identity?.Name,
            AuthConfig.AutoLoginByWorkspace);

        globalSettings = GlobalSettingsService.GetSettings();
        moduleState = StateService.GetState(GraphicModule.Faldon);
        moduleElectionSlot = DatabaseMonitor.CurrentValue.ClampSlot(moduleState.ElectionSlot);
        moduleOficiales = moduleState.Oficiales;
        moduleLanguage = moduleState.GraphicLanguage;
        if (moduleElectionSlot != moduleState.ElectionSlot)
        {
            moduleState = StateService.ConfigureModule(GraphicModule.Faldon, moduleElectionSlot, moduleOficiales);
        }

        videoSources = LoadVideoSourcesFromConfig();
        selectedVideoSlot = videoSources.FirstOrDefault()?.Slot ?? 1;

        GlobalSettingsService.OnSettingsChanged += HandleGlobalSettingsChanged;
        StateService.OnStateChanged += HandleOperationalStateChanged;
        ModuleLockService.LocksChanged += HandleLocksChanged;
        ConfigService.ConfigurationChanged += HandleConfigurationChanged;
        dbOptionsSubscription = DatabaseMonitor.OnChange(_ => HandleConfigurationChanged());

        EnsureAutoLock();
        await ReloadReferenceDataAsync();
        await LoadPartiesAsync();
    }

    private void EnsureAutoLock()
    {
        if (CanOperate && !IsOwner)
        {
            ModuleLockService.TryAcquire(GraphicModule.Faldon, operatorId);
        }
    }

    private void ClaimModuleLock()
    {
        if (!CanOperate)
        {
            return;
        }

        ModuleLockService.ForceRelease(GraphicModule.Faldon);
        var ok = ModuleLockService.TryAcquire(GraphicModule.Faldon, operatorId);
        feedbackMessage = ok ? "Control de Faldón activo." : "No se pudo tomar el control.";
        feedbackIsError = !ok;
    }

    private static string GetModeLabel(FaldonMode mode) => mode switch
    {
        FaldonMode.General => "Escrutinio / Sondeo",
        FaldonMode.Ticker => "Ticker",
        FaldonMode.Sedes => "Sedes",
        FaldonMode.VideoPrime => "Vídeo / Prime",
        FaldonMode.Pactometro => "Pactómetro",
        FaldonMode.UltimoEscano => "Último escaño",
        FaldonMode.CuentaAtras => "Cuenta Atrás",
        _ => mode.ToString()
    };

    private void SelectMode(FaldonMode mode)
    {
        activeMode = mode;
    }

    private async Task SetModuleOficialesAsync(bool oficiales)
    {
        if (moduleOficiales == oficiales)
        {
            return;
        }

        moduleOficiales = oficiales;
        moduleState = StateService.ConfigureModule(GraphicModule.Faldon, moduleElectionSlot, moduleOficiales);
        await LoadPartiesAsync();
    }

    private async Task OnModuleElectionSlotChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var parsedSlot))
        {
            return;
        }

        var clamped = DatabaseMonitor.CurrentValue.ClampSlot(parsedSlot);
        if (clamped == moduleElectionSlot)
        {
            return;
        }

        moduleElectionSlot = clamped;
        moduleState = StateService.ConfigureModule(GraphicModule.Faldon, moduleElectionSlot, moduleOficiales);
        await ReloadReferenceDataAsync();
        await LoadPartiesAsync();
    }

    private async Task TogglePrimerosResultadosAsync()
    {
        var nextCommand = moduleState.PrimerosResultadosEnabled
            ? GraphicCommand.PrimerosResultadosDesactiva
            : GraphicCommand.PrimerosResultadosActiva;
        await RunCommandAsync(nextCommand);
    }

    private async Task ToggleAnimacionSondeoAsync()
    {
        var nextCommand = moduleState.AnimacionSondeoEnabled
            ? GraphicCommand.AnimacionSondeoDesactiva
            : GraphicCommand.AnimacionSondeoActiva;
        await RunCommandAsync(nextCommand);
    }

    private async Task SetAmbitoEuropaAsync(bool europa)
    {
        var command = europa
            ? GraphicCommand.CambioEleccionesEuropa
            : GraphicCommand.CambioEleccionesNacional;
        await RunCommandAsync(command);
    }

    private async Task TransitionSondeoToOficialesAsync()
    {
        var hadSondeo = !moduleOficiales;
        moduleOficiales = true;
        moduleState = StateService.ConfigureModule(GraphicModule.Faldon, moduleElectionSlot, moduleOficiales);
        await RunCommandAsync(GraphicCommand.DeSondeoAOficiales);
        if (hadSondeo)
        {
            await LoadPartiesAsync();
        }
    }

    private void OnPartySelected(PartidoSnapshot party)
    {
        selectedPartyCode = party.Codigo;
    }

    private Task ToggleLeftPactPartySelection(PartidoSnapshot party) =>
        TogglePactPartySelection(selectedLeftPactPartyCodes, party);

    private Task ToggleRightPactPartySelection(PartidoSnapshot party) =>
        TogglePactPartySelection(selectedRightPactPartyCodes, party);

    private static Task TogglePactPartySelection(List<string> selection, PartidoSnapshot party)
    {
        var index = selection.FindIndex(code =>
            string.Equals(code, party.Codigo, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            selection.RemoveAt(index);
        }
        else
        {
            selection.Add(party.Codigo);
        }

        return Task.CompletedTask;
    }

    private async Task OnPartyDoubleClickedAsync(PartidoSnapshot party)
    {
        selectedPartyCode = party.Codigo;
        if (activeMode == FaldonMode.Sedes)
        {
            await RunPartyCommandAsync(GraphicCommand.SedesEntra);
        }
        else if (activeMode == FaldonMode.VideoPrime && videoSelectionMode == "party")
        {
            await ExecuteVideoCommandAsync(GraphicCommand.VideoIn);
        }
    }

    private async Task OnCircunscripcionSelectedAsync(string codigo)
    {
        selectedCircunscripcionCodigo = codigo ?? string.Empty;
        await LoadPartiesAsync();
    }

    private async Task OnGraphicLanguageChangedAsync(ChangeEventArgs args)
    {
        if (!Enum.TryParse<GraphicLanguage>(args.Value?.ToString(), out var selectedLang))
        {
            return;
        }

        moduleLanguage = selectedLang;
        await RunCommandAsync(selectedLang.ToGraphicCommand());
    }

    private async Task OnMedioChangedAsync(ChangeEventArgs args)
    {
        selectedMedioCodigo = args.Value?.ToString() ?? "RTVE";
        await LoadPartiesAsync();
    }

    private async Task ReloadReferenceDataAsync()
    {
        try
        {
            var previousCirc = selectedCircunscripcionCodigo;
            var previousMedio = selectedMedioCodigo;

            circunscripciones = await DataService.GetCircunscripcionesAsync(moduleElectionSlot, globalSettings.ConnectionType);
            selectedCircunscripcionCodigo = circunscripciones.FirstOrDefault(x => x.Codigo == previousCirc)?.Codigo
                ?? circunscripciones.FirstOrDefault()?.Codigo
                ?? string.Empty;

            var loadedMedios = await DataService.GetMediosAsync(moduleElectionSlot, globalSettings.ConnectionType);
            var list = new List<MedioSummary> { new("RTVE", "RTVE") };
            list.AddRange(loadedMedios
                .Where(x => !string.IsNullOrWhiteSpace(x.Codigo) && !string.Equals(x.Codigo, "RTVE", StringComparison.OrdinalIgnoreCase))
                .DistinctBy(x => x.Codigo)
                .Select(x => new MedioSummary(x.Codigo.Trim(), string.IsNullOrWhiteSpace(x.Descripcion) ? x.Codigo.Trim() : x.Descripcion.Trim())));
            medios = list;
            selectedMedioCodigo = medios.FirstOrDefault(x => string.Equals(x.Codigo, previousMedio, StringComparison.OrdinalIgnoreCase))?.Codigo
                ?? "RTVE";
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error consultando circunscripciones de la elección activa: {ex.Message}";
            feedbackIsError = true;
        }
    }

    private async Task LoadPartiesAsync()
    {
        loadingParties = true;
        try
        {
            var snapshot = await DataService.GetSnapshotAsync(BuildQuery(), moduleOficiales);
            currentSnapshot = snapshot;
            availableParties = snapshot.Partidos
                .Where(x => !string.IsNullOrWhiteSpace(x.Codigo))
                .OrderByDescending(GetDisplayEscanos)
                .ThenByDescending(x => x.PorcentajeVoto)
                .ThenByDescending(x => x.Votos)
                .ToList();
            SyncPactometerPartiesFromState();

            if (string.IsNullOrWhiteSpace(selectedPartyCode) || !availableParties.Any(p => string.Equals(p.Codigo, selectedPartyCode, StringComparison.OrdinalIgnoreCase)))
            {
                selectedPartyCode = availableParties.FirstOrDefault()?.Codigo ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error cargando partidos: {ex.Message}";
            feedbackIsError = true;
        }
        finally
        {
            loadingParties = false;
        }
    }

    private async Task RunSceneActionAsync(OperationActionType action)
    {
        if (activeMode == FaldonMode.UltimoEscano
            && !moduleOficiales
            && action != OperationActionType.Exit)
        {
            feedbackMessage = "El gráfico de Último escaño solo está disponible con datos Oficiales.";
            feedbackIsError = true;
            return;
        }

        EnsureAutoLock();
        var request = new OperationRequest
        {
            OperatorId = operatorId,
            Module = GraphicModule.Faldon,
            Scene = ActiveSceneName,
            Action = action,
            SceneSeconds = activeMode == FaldonMode.CuentaAtras && sceneSeconds > 0 ? sceneSeconds : null,
            Command = GraphicCommand.None,
            Target = globalSettings.Target,
            Oficiales = moduleOficiales,
            ExportName = globalSettings.ExportName,
            Query = BuildQuery()
        };

        var result = await OperationService.ExecuteAsync(request);
        feedbackMessage = result.Message;
        feedbackIsError = !result.Success;
    }

    private async Task<bool> RunCommandAsync(
        GraphicCommand command,
        string commandValue = "",
        IReadOnlyList<string>? partyCodes = null,
        IReadOnlyList<string>? leftPartyCodes = null,
        IReadOnlyList<string>? rightPartyCodes = null)
    {
        EnsureAutoLock();
        var request = new OperationRequest
        {
            OperatorId = operatorId,
            Module = GraphicModule.Faldon,
            Scene = ActiveSceneName,
            Action = OperationActionType.Update,
            SceneSeconds = activeMode == FaldonMode.CuentaAtras && sceneSeconds > 0 ? sceneSeconds : null,
            Command = command,
            CommandValue = commandValue,
            PartyCodes = partyCodes ?? [],
            LeftPartyCodes = leftPartyCodes ?? [],
            RightPartyCodes = rightPartyCodes ?? [],
            Target = globalSettings.Target,
            Oficiales = moduleOficiales,
            ExportName = globalSettings.ExportName,
            Query = BuildQuery()
        };

        var result = await OperationService.ExecuteAsync(request);
        feedbackMessage = result.Message;
        feedbackIsError = !result.Success;
        return result.Success;
    }

    private async Task RunPartyCommandAsync(GraphicCommand command)
    {
        if (SelectedParty is null)
        {
            return;
        }

        await RunCommandAsync(command, SelectedParty.Codigo);
    }

    private async Task ExecuteVideoCommandAsync(GraphicCommand command)
    {
        var commandValue = command switch
        {
            GraphicCommand.VideoInTodos or GraphicCommand.VideoOutTodos => string.Empty,
            _ => videoSelectionMode == "slot" ? $"slot:{selectedVideoSlot}" : (SelectedParty?.Codigo ?? string.Empty)
        };

        await RunCommandAsync(command, commandValue);
    }

    private async Task ResetPactosAsync()
    {
        if (await RunCommandAsync(GraphicCommand.PactosReinicio))
        {
            leftParties.Clear();
            rightParties.Clear();
            selectedLeftPactPartyCodes.Clear();
            selectedRightPactPartyCodes.Clear();
        }
    }

    private async Task ApplyPactometerPartiesAsync(bool izquierda)
    {
        var command = izquierda
            ? GraphicCommand.PactosEntraIzquierda
            : GraphicCommand.PactosEntraDerecha;
        var codes = (izquierda ? selectedLeftPactPartyCodes : selectedRightPactPartyCodes).ToArray();
        if (codes.Length == 0 || !await RunCommandAsync(command, partyCodes: codes))
        {
            return;
        }

        var target = izquierda ? leftParties : rightParties;
        target.Clear();
        target.AddRange(codes
            .Select(code => DisplayedParties.Concat(FullCircunscripcionParties)
                .FirstOrDefault(p => string.Equals(p.Codigo, code, StringComparison.OrdinalIgnoreCase)))
            .OfType<PartidoSnapshot>());
    }

    private async Task ApplyBothPactometerPartiesAsync()
    {
        var leftCodes = selectedLeftPactPartyCodes.ToArray();
        var rightCodes = selectedRightPactPartyCodes.ToArray();
        if (leftCodes.Length == 0
            || rightCodes.Length == 0
            || !await RunCommandAsync(
            GraphicCommand.PactosEntraAmbos,
            leftPartyCodes: leftCodes,
            rightPartyCodes: rightCodes))
        {
            return;
        }

        ReplacePactometerParties(leftParties, leftCodes);
        ReplacePactometerParties(rightParties, rightCodes);
    }

    private async Task ClearLeftAsync()
    {
        if (await RunCommandAsync(GraphicCommand.PactosSaleIzquierda))
        {
            leftParties.Clear();
        }
    }

    private async Task ClearRightAsync()
    {
        if (await RunCommandAsync(GraphicCommand.PactosSaleDerecha))
        {
            rightParties.Clear();
        }
    }

    private void SyncPactometerPartiesFromState()
    {
        ReplacePactometerParties(leftParties, moduleState.PactosIzquierda);
        ReplacePactometerParties(rightParties, moduleState.PactosDerecha);
    }

    private void ReplacePactometerParties(List<PartidoSnapshot> destination, IReadOnlyList<string> codes)
    {
        var sourceParties = availableParties.Concat(FullCircunscripcionParties);
        var partiesByCode = sourceParties
            .GroupBy(p => p.Codigo, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);

        destination.Clear();
        foreach (var code in codes)
        {
            if (partiesByCode.TryGetValue(code, out var party))
            {
                destination.Add(party);
            }
        }
    }

    private int GetDisplayEscanos(PartidoSnapshot p) => moduleOficiales ? p.Escanios : p.EscaniosHastaSondeo;

    private int TotalAvailableEscanos => Math.Max(1, currentSnapshot?.EscaniosTotales > 0 ? currentSnapshot.EscaniosTotales : availableParties.Sum(GetDisplayEscanos));
    private int LeftPactEscanos => leftParties.Sum(GetDisplayEscanos);
    private int RightPactEscanos => rightParties.Sum(GetDisplayEscanos);
    private string LeftPactPctCss => $"{Math.Clamp(LeftPactEscanos * 100.0 / TotalAvailableEscanos, 0, 100).ToString("0.##", CultureInfo.InvariantCulture)}%";
    private string RightPactPctCss => $"{Math.Clamp(RightPactEscanos * 100.0 / TotalAvailableEscanos, 0, 100).ToString("0.##", CultureInfo.InvariantCulture)}%";

    private SnapshotQuery BuildQuery() => new()
    {
        ElectionSlot = moduleElectionSlot,
        ConnectionType = globalSettings.ConnectionType,
        Kind = SnapshotQueryKind.Circunscripcion,
        CircunscripcionCodigo = selectedCircunscripcionCodigo,
        Avance = globalSettings.Avance == 0 ? null : globalSettings.Avance,
        IncludeZeroSeats = globalSettings.IncludeZeroSeats,
        MedioCodigo = selectedMedioCodigo.Trim()
    };

    private IReadOnlyList<VideoSourceOptions> LoadVideoSourcesFromConfig()
    {
        var result = new List<VideoSourceOptions>();
        for (var i = 0; i < 6; i++)
        {
            var slot = int.TryParse(Configuration[$"Operational:VideoSources:{i}:Slot"], out var parsedSlot) ? Math.Clamp(parsedSlot, 1, 6) : i + 1;
            var isLive = bool.TryParse(Configuration[$"Operational:VideoSources:{i}:IsLive"], out var parsedLive) && parsedLive;
            var path = Configuration[$"Operational:VideoSources:{i}:Path"]?.Trim() ?? string.Empty;
            result.Add(new VideoSourceOptions { Slot = slot, IsLive = isLive, Path = path });
        }

        return result.OrderBy(x => x.Slot).ToList();
    }

    private void HandleGlobalSettingsChanged(GlobalOperationalSettings updated)
    {
        _ = InvokeAsync(async () =>
        {
            var connChanged = updated.ConnectionType != globalSettings.ConnectionType;
            var queryFilterChanged = updated.IncludeZeroSeats != globalSettings.IncludeZeroSeats
                                     || updated.Avance != globalSettings.Avance;
            var autoRefreshApplied = updated.LastAutoRefreshAppliedUtc != globalSettings.LastAutoRefreshAppliedUtc;
            globalSettings = updated;

            if (connChanged)
            {
                await ReloadReferenceDataAsync();
            }

            if (connChanged || queryFilterChanged || autoRefreshApplied)
            {
                await LoadPartiesAsync();
            }

            StateHasChanged();
        });
    }

    private void HandleOperationalStateChanged(GraphicModule module, ModuleOperationalState state)
    {
        if (module != GraphicModule.Faldon)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            var slotChanged = state.ElectionSlot != moduleElectionSlot;
            var modeChanged = state.Oficiales != moduleOficiales;
            moduleState = state;
            moduleElectionSlot = state.ElectionSlot;
            moduleOficiales = state.Oficiales;
            moduleLanguage = state.GraphicLanguage;
            SyncPactometerPartiesFromState();

            if (slotChanged)
            {
                await ReloadReferenceDataAsync();
            }

            if (slotChanged || modeChanged)
            {
                await LoadPartiesAsync();
            }

            StateHasChanged();
        });
    }

    private void HandleLocksChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleConfigurationChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var clamped = DatabaseMonitor.CurrentValue.ClampSlot(moduleElectionSlot);
            if (clamped != moduleElectionSlot)
            {
                moduleElectionSlot = clamped;
                moduleState = StateService.ConfigureModule(GraphicModule.Faldon, moduleElectionSlot, moduleOficiales);
            }

            await ReloadReferenceDataAsync();
            await LoadPartiesAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        GlobalSettingsService.OnSettingsChanged -= HandleGlobalSettingsChanged;
        StateService.OnStateChanged -= HandleOperationalStateChanged;
        ModuleLockService.LocksChanged -= HandleLocksChanged;
        ConfigService.ConfigurationChanged -= HandleConfigurationChanged;
        dbOptionsSubscription?.Dispose();
    }
}
