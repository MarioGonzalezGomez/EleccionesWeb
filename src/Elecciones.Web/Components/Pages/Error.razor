@page "/Error"
@using System.Diagnostics

<PageTitle>Error - Consola de Operación</PageTitle>

<div class="ws-auth-page">
    <div class="ws-auth-card text-center">
        <div class="ws-chip ws-chip-danger mb-3">Incidencia de aplicación</div>

        <h1 class="h5 mb-2 fw-semibold">Ha ocurrido un error inesperado</h1>
        <p class="small text-muted mb-4">
            No se pudo completar la operación solicitada en la consola.
        </p>

        @if (ShowRequestId)
        {
            <div class="ws-subcard text-start mb-4">
                <div class="ws-kpi-label">Identificador de traza (Request ID)</div>
                <code>@RequestId</code>
            </div>
        }

        <a href="/operacion" class="ws-btn ws-btn-primary w-100 py-2 text-decoration-none">
            Volver a la consola
        </a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
